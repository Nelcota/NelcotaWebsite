# Development image used by compose.yaml: the Astro dev server with the
# project's dependencies, so nothing but Docker is needed on the machine.
# Production stays in Dockerfile (static build served by Caddy).

FROM node:26.11.1-bookworm-slim
WORKDIR /app
RUN npm install --global pnpm@12.14.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
EXPOSE 4321
# 0.0.0.0 so the port published by Docker reaches the dev server.
CMD ["pnpm", "dev", "--host", "0.0.0.0"]
