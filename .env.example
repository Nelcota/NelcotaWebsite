# Optional. Raises the GitHub API rate limit for the build-time loader and `pnpm snapshot`.
# Without it the loader still works (60 requests/hour) and falls back to src/data/github-snapshot.json.
GITHUB_TOKEN=

# Optional. Public origin and base path of the deployed site (used for canonical URLs, sitemap and OG images).
# The GitHub Pages workflow sets both automatically from actions/configure-pages.
SITE_URL=https://nelcota.github.io
BASE_PATH=/
