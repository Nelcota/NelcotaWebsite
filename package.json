{
  "name": "nelcota-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static website for the Nelcota GitHub organization, built with Astro.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "playwright test",
    "lhci": "lhci autorun",
    "snapshot": "node scripts/snapshot.ts",
    "astro": "astro",
    "csp-hash": "node scripts/csp-hash.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "satori": "0.62.0",
    "sharp": "0.35.5",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.15",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "sharp"
    ]
  }
}
