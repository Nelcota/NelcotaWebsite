{
  "name": "nelcota-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Website and documentation of Nelcota, the open-source Rust backend for PostgreSQL.",
  "license": "Apache-2.0",
  "homepage": "https://nelcota.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nelcota/NelcotaWebsite.git"
  },
  "bugs": {
    "url": "https://github.com/Nelcota/NelcotaWebsite/issues"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "playwright test",
    "test:unit": "node --test tests/unit/",
    "lhci": "lhci autorun",
    "snapshot": "node scripts/snapshot.ts",
    "docs:sync": "node scripts/sync-docs.ts",
    "docs:check": "node scripts/sync-docs.ts --check",
    "astro": "astro",
    "sizes": "node scripts/sizes.ts",
    "test:ci": "pnpm docs:check && pnpm test:unit && pnpm build && playwright test && pnpm sizes && lhci autorun",
    "subset-fonts": "node scripts/subset-fonts.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "gsap": "3.15.0",
    "marked": "18.1.1",
    "satori": "0.62.0",
    "sharp": "0.35.5",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "subset-font": "2.9.0",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "sharp"
    ]
  }
}
