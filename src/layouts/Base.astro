---
import { Font, getImage } from 'astro:assets';
import mascot from '../assets/mascot.png';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import { bcp47, type Locale, t } from '../i18n/utils.ts';
import { withBase } from '../lib/site.ts';
import themeInit from '../scripts/theme-init.js?raw';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | undefined;
  fetchedAt?: string | null;
  /** Locale-independent page path ('' for home), for canonical/hreflang and the language switch. */
  path?: string;
}

const { locale, noindex = false, jsonLd, fetchedAt = null, path = '' } = Astro.props;
const dict = t(locale);
const title = Astro.props.title ?? dict.meta.title;
const description = Astro.props.description ?? dict.meta.description;
const appleTouchIcon = await getImage({ src: mascot, width: 180, height: 180, format: 'png' });
---

<!doctype html>
<html lang={bcp47[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* Applies the stored theme before first paint; hashed in the CSP (see astro.config.ts). */}
    <script is:inline set:html={themeInit} />
    <title>{title}</title>
    <Seo
      locale={locale}
      title={title}
      description={description}
      ogAlt={dict.meta.ogAlt}
      noindex={noindex}
      jsonLd={jsonLd}
      path={path}
    />
    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <link rel="icon" href={withBase('favicon.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />
    <link rel="manifest" href={withBase('manifest.webmanifest')} />
    <link rel="stylesheet" href={withBase('print.css')} media="print" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f5f4" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101113" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-(--z-skip-link) focus:rounded-[var(--radius-control)] focus:bg-ink focus:px-4 focus:py-2 focus:font-medium focus:text-on-ink"
    >
      {dict.a11y.skipToContent}
    </a>
    <Header locale={locale} path={path} />
    <main id="main" class="flex-1 overflow-x-clip pt-[calc(4rem+env(safe-area-inset-top))]">
      <slot />
    </main>
    <p data-copy-status role="status" aria-live="polite" class="sr-only"></p>
    <Footer locale={locale} fetchedAt={fetchedAt} />
  </body>
</html>

