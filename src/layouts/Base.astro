---
import { Font, getImage } from 'astro:assets';
import mascot from '../assets/mascot.png';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import { bcp47, type Locale, t } from '../i18n/utils.ts';
import { withBase } from '../lib/site.ts';
import themeInit from '../scripts/theme-init.js?raw';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | undefined;
  fetchedAt?: string | null;
  source?: 'api' | 'snapshot' | null;
}

const { locale, noindex = false, jsonLd, fetchedAt = null, source = null } = Astro.props;
const dict = t(locale);
const title = Astro.props.title ?? dict.meta.title;
const description = Astro.props.description ?? dict.meta.description;
const appleTouchIcon = await getImage({ src: mascot, width: 180, height: 180, format: 'png' });
---

<!doctype html>
<html lang={bcp47[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Applies the stored theme before first paint; hashed in the CSP (see astro.config.ts). */}
    <script is:inline set:html={themeInit} />
    <title>{title}</title>
    <Seo
      locale={locale}
      title={title}
      description={description}
      ogAlt={dict.meta.ogAlt}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />
    <link rel="manifest" href={withBase('manifest.webmanifest')} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6faf7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d1310" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-mint focus:px-4 focus:py-2 focus:font-semibold focus:text-on-mint"
    >
      {dict.a11y.skipToContent}
    </a>
    <Header locale={locale} />
    <main id="main" class="flex-1 pt-16">
      <slot />
    </main>
    <Footer locale={locale} fetchedAt={fetchedAt} source={source} />
  </body>
</html>
