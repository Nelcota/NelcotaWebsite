---
import { type Locale, t } from '../i18n/utils.ts';
import type { ProjectsData } from '../lib/projects.ts';
import ProjectCard from './ProjectCard.astro';

interface Props {
  locale: Locale;
  projects: ProjectsData;
}
const { locale, projects } = Astro.props;
const dict = t(locale);
const now = new Date();
const featured = projects.primary.find((project) => project.data.featured);
const others = projects.primary.filter((project) => project !== featured);
---

<section id="projects" class="scroll-mt-24 py-16 md:py-24" aria-labelledby="projects-title">
  <div class="container-page">
    <div class="max-w-2xl">
      <h2 id="projects-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">{dict.projects.title}</h2>
      <p class="mt-3 text-lg text-pretty text-muted">{dict.projects.intro}</p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {
        featured && (
          <div class="lg:col-span-2 lg:row-span-2">
            <ProjectCard project={featured} locale={locale} variant="featured" now={now} />
          </div>
        )
      }
      {others.map((project) => <ProjectCard project={project} locale={locale} now={now} />)}
    </div>

    {
      projects.secondary.length > 0 && (
        <div class="mt-12">
          <h3 class="text-sm font-semibold tracking-wide text-muted uppercase">{dict.projects.moreTitle}</h3>
          <div class="mt-4 grid gap-5 md:grid-cols-2">
            {projects.secondary.map((project) => (
              <ProjectCard project={project} locale={locale} variant="compact" now={now} />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
