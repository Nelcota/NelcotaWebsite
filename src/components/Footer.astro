---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { formatDate, type Locale, t } from '../i18n/utils.ts';
import { docHref, isExternal } from '../lib/docs/links.ts';
import { DOCS, LICENSE, REPO_URL, SITE_NAME } from '../lib/site.ts';
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';

/**
 * Gallery-style footer: one soft gray rounded panel inside the page margins,
 * with the promise and the social buttons on the left, three link columns
 * (the newest page wears a "New" badge) and the legal line at the bottom.
 */
interface Props {
  locale: Locale;
  fetchedAt?: string | null;
}
const { locale, fetchedAt = null } = Astro.props;
const dict = t(locale);
const home = getRelativeLocaleUrl(locale);
const year = new Date().getUTCFullYear();
const hasFetchedAt = fetchedAt != null && fetchedAt.length > 0;

interface FooterLink {
  readonly label: string;
  readonly href: string;
  readonly isNew?: boolean;
}

const columns: ReadonlyArray<{ title: string; links: readonly FooterLink[] }> = [
  {
    title: dict.footer.product,
    links: [
      { label: dict.nav.howItWorks, href: `${home}#how-it-works` },
      { label: dict.nav.speed, href: `${home}#speed` },
      { label: dict.nav.security, href: `${home}#security` },
      { label: dict.nav.getStarted, href: `${home}#start` },
      { label: dict.footer.compare, href: getRelativeLocaleUrl(locale, 'compare/'), isNew: true },
    ],
  },
  {
    title: dict.footer.resources,
    links: [
      { label: dict.footer.documentation, href: docHref('index', locale) },
      { label: dict.footer.releases, href: DOCS.releases },
      { label: dict.footer.changelog, href: DOCS.changelog },
      { label: dict.footer.security, href: DOCS.securityPolicy },
    ],
  },
  {
    title: dict.footer.community,
    links: [
      { label: 'GitHub', href: REPO_URL },
      { label: dict.footer.contributing, href: DOCS.contributing },
      { label: dict.footer.conduct, href: DOCS.conduct },
      { label: dict.footer.license, href: DOCS.license },
    ],
  },
];
---

<footer class="px-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] sm:px-4" data-hides-sticky-cta>
  <div class="mx-auto max-w-[90rem] rounded-[2rem] bg-band px-6 py-12 sm:px-10 md:py-14 lg:px-14">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_2fr]">
      <div>
        <a href={home} class="inline-flex items-center gap-2.5 text-[0.9375rem] font-semibold tracking-tight text-ink">
          <BrandMark />
          {SITE_NAME}
        </a>
        <p class="mt-8 text-[clamp(1.75rem,3vw,2.25rem)] leading-[1.05] font-semibold tracking-[-0.04em] text-ink">
          {dict.footer.title}
        </p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">{dict.footer.tagline}</p>
        <div class="mt-6 flex gap-2">
          <a href={REPO_URL} rel="noopener" aria-label="GitHub" data-tooltip="GitHub" class="inline-flex size-11 items-center justify-center rounded-full bg-surface text-ink shadow-sm transition-colors hover:text-mint-ink">
            <Icon name="github" size={18} />
          </a>
          <a href={DOCS.releases} rel="noopener" aria-label={dict.footer.releases} data-tooltip={dict.footer.releases} class="inline-flex size-11 items-center justify-center rounded-full bg-surface text-ink shadow-sm transition-colors hover:text-mint-ink">
            <Icon name="package" size={18} />
          </a>
          <a href={docHref('index', locale)} aria-label={dict.footer.documentation} data-tooltip={dict.footer.documentation} class="inline-flex size-11 items-center justify-center rounded-full bg-surface text-ink shadow-sm transition-colors hover:text-mint-ink">
            <Icon name="book" size={18} />
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
        {
          columns.map((column) => (
            <nav aria-label={column.title}>
              <p class="text-xs font-semibold text-faint">{column.title}</p>
              <ul class="mt-3 text-sm">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      rel={isExternal(link.href) ? 'noopener' : undefined}
                      class="inline-flex items-center gap-2 py-2.5 font-medium text-ink transition-colors hover:text-mint-ink"
                    >
                      {link.label}
                      {link.isNew && (
                        <span class="rounded-full bg-pop-pink px-1.5 py-0.5 text-[0.625rem] font-bold text-white">{dict.footer.newBadge}</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-1.5 border-t border-line pt-6 text-xs text-faint md:flex-row md:items-center md:justify-between">
      <p>{dict.footer.licenseNote} {dict.footer.fonts}</p>
      <p>
        {hasFetchedAt && (
          <>
            {dict.footer.dataAsOf} <time datetime={fetchedAt}>{formatDate(fetchedAt, locale)}</time> ·{' '}
          </>
        )}
        © {year} {SITE_NAME} · {LICENSE}
      </p>
    </div>
  </div>
</footer>
