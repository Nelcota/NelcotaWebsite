---
import { type Locale, t } from '../i18n/utils.ts';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const cards = [
  { icon: 'book', ...dict.contribute.guide },
  { icon: 'shield', ...dict.contribute.security },
] as const;
---

<section id="contribute" class="scroll-mt-24 bg-surface/60 py-16 md:py-24" aria-labelledby="contribute-title">
  <div class="container-page">
    <div class="max-w-2xl">
      <h2 id="contribute-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">{dict.contribute.title}</h2>
      <p class="mt-3 text-lg text-pretty text-muted">{dict.contribute.intro}</p>
    </div>
    <ul class="mt-10 grid gap-5 md:grid-cols-2">
      {
        cards.map((card) => (
          <li class="card relative p-6 transition-shadow hover:shadow-float">
            <span class="inline-flex size-11 items-center justify-center rounded-2xl bg-mint-soft text-mint-ink">
              <Icon name={card.icon} size={22} />
            </span>
            <h3 class="mt-4 text-lg font-semibold">
              <a href={card.href} rel="noopener" class="after:absolute after:inset-0 after:rounded-[var(--radius-card)]">
                {card.label}
              </a>
            </h3>
            <p class="mt-2 text-sm text-pretty text-muted">{card.body}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-mint-ink">
              GitHub <Icon name="external" size={14} />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
