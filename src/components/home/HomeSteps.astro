---
import { type Locale, t } from '../../i18n/utils.ts';
import { docHref } from '../../lib/docs/links.ts';
import type { Snippets } from '../../lib/snippets.ts';
import CodeBlock from '../CodeBlock.astro';
import Icon from '../Icon.astro';
import Eyebrow from './Eyebrow.astro';
import Title from './Title.astro';

/**
 * "Zero to API in three steps": copy and a pill link on the left, the three
 * quickstart steps as a carousel of cards with their real commands on the
 * right (the reference's "Marketplace for Creativity" row), with arrows and a
 * progress bar (carousel.ts). Commands: docs/quickstart.md via snippets.ts.
 */
interface Props {
  locale: Locale;
  snippets: Snippets;
}
const { locale, snippets } = Astro.props;
const dict = t(locale);
const steps = dict.landing.steps;

const items = steps.items.map((item, index) => {
  const block = snippets.quickstart[index];
  if (block == null) throw new RangeError(`HomeSteps: step ${index + 1} has no quickstart snippet`);

  return { ...item, block };
});
---

<section id="start" class="scroll-mt-24 overflow-x-clip py-12 md:py-20" aria-labelledby="steps-title" data-hides-sticky-cta>
  <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl">
        <Eyebrow parts={steps.eyebrow} />
        <Title id="steps-title" parts={steps.title} class="mt-5" />
        <p class="mt-5 leading-relaxed text-pretty text-muted" data-fade>{steps.body}</p>
      </div>
      <a href={docHref('quickstart', locale)} class="inline-flex min-h-11 items-center gap-1.5 rounded-full bg-pop-pink px-5 text-sm font-semibold text-white" data-fade>
        {steps.all}
        <Icon name="arrow" size={15} />
      </a>
    </div>

    <div class="mt-12" data-carousel>
      <ol class="-mx-5 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 pb-2 sm:scroll-px-8 [scrollbar-width:none] sm:-mx-8 sm:px-8" data-carousel-track>
        {
          items.map((item, index) => (
            <li class="card flex w-[min(34rem,88vw)] shrink-0 snap-start flex-col p-5 sm:p-6">
              <p class="flex items-center gap-3">
                <span class="flex size-9 items-center justify-center rounded-full bg-ink text-sm font-semibold text-canvas">{index + 1}</span>
                <span class="text-xl font-semibold tracking-[-0.02em] text-ink">{item.title}</span>
              </p>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-pretty text-muted">{item.body}</p>
              <CodeBlock block={item.block} locale={locale} class="mt-5 overflow-hidden rounded-[var(--radius-card)] [&_pre]:max-h-[18rem] [&_pre]:overflow-y-auto" />
            </li>
          ))
        }
      </ol>

      <div class="mt-6 flex items-center gap-4">
        <button type="button" class="carousel-arrow" aria-label={steps.prev} data-carousel-prev>
          <Icon name="chevronRight" size={16} class="rotate-180" />
        </button>
        <button type="button" class="carousel-arrow" aria-label={steps.next} data-carousel-next>
          <Icon name="chevronRight" size={16} />
        </button>
        <span class="progress h-0.5 flex-1 overflow-hidden rounded-full bg-line" aria-hidden="true">
          <span class="progress-fill block h-full bg-ink" data-carousel-bar></span>
        </span>
      </div>
    </div>
  </div>
</section>


<style>
  .progress-fill {
    width: 100%;
    transform: scaleX(calc(0.2 + var(--progress, 0) * 0.8));
    transform-origin: left;
    transition: transform 200ms var(--ease-soft);
  }
</style>
