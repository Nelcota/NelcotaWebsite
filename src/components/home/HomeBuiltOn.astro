---
import { Image } from 'astro:assets';
import rustlsLogo from '../../assets/logos/rustls.png';
import { type Locale, t } from '../../i18n/utils.ts';
import Mark, { brand, type MarkSpec } from '../Mark.astro';
import Title from './Title.astro';

/**
 * "Built on the best": the real stack under the binary, as a slow logo strip
 * (the reference's "Trusted by the best" row). Every name is a dependency or
 * a tool the product actually uses (Cargo.toml, docs/deploy.md, docs/backup.md).
 * The strip drifts with CSS and stops with reduced motion or the page-level
 * pause button.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const builtOn = t(locale).landing.builtOn;

/** A mark from the sprite, or (rustls, a full-color drawing) a small image. */
type Item = { readonly name: string; readonly mark?: MarkSpec; readonly image?: ImageMetadata };
const STACK: readonly Item[] = [
  { name: 'Rust', mark: brand('rust') },
  { name: 'PostgreSQL', mark: brand('postgresql') },
  { name: 'tokio', mark: brand('tokio') },
  { name: 'axum' },
  // rustls logo: rustls/rustls admin/logo, CC BY-NC 4.0, credited in the README (Licenses).
  { name: 'rustls', image: rustlsLogo },
  { name: 'Docker', mark: brand('docker') },
  { name: 'Caddy', mark: brand('caddy') },
  { name: 'pgBackRest', mark: brand('pgbackrest') },
  { name: 'TypeScript', mark: brand('typescript') },
  { name: 'Linux', mark: brand('linux') },
];
/**
 * Each set spans at least the viewport, so two copies cover the whole loop
 * even on ultrawide screens.
 */
const copies = [0, 1] as const;
---

<section class="overflow-x-clip py-14 md:py-20" aria-labelledby="built-title">
  <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
    <Title id="built-title" parts={builtOn.title} split={false} size="card" />
    <p class="mt-3 max-w-md text-sm leading-relaxed text-muted" data-fade>{builtOn.body}</p>
  </div>

  <div class="logos mt-12" data-fade>
    <div class="logos-track">
      {
        copies.map((copy) => (
          <ul class="logos-set" aria-hidden={copy > 0 ? 'true' : undefined}>
            {STACK.map((item) => (
              <li class="logo">
                {item.mark && <Mark mark={item.mark} size={22} />}
                {item.image && <Image src={item.image} alt="" widths={[32, 64]} sizes="32px" class="h-[1.5rem] w-auto" loading="lazy" />}
                <span>{item.name}</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  .logos {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .logos-track {
    display: flex;
    width: max-content;
  }
  .logos-set {
    display: flex;
    flex-shrink: 0;
    min-width: 100vw;
    justify-content: space-around;
    align-items: center;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: 3.5rem;
    color: var(--color-faint);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
    filter: grayscale(1);
    opacity: 0.85;
  }
  /* Each set moves by its own width, so the loop is seamless with any number of copies. */
  @media (prefers-reduced-motion: no-preference) {
    .logos-set {
      animation: logos-drift 40s linear infinite;
    }
  }
  :global([data-motion-paused]) .logos-set {
    animation-play-state: paused;
  }
  @keyframes logos-drift {
    to {
      transform: translateX(-100%);
    }
  }
</style>
