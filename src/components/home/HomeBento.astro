---
import { type Locale, t } from '../../i18n/utils.ts';
import { docHref } from '../../lib/docs/links.ts';
import type { DocKey } from '../../lib/site.ts';
import Icon, { type IconName } from '../Icon.astro';
import Eyebrow from './Eyebrow.astro';
import Title from './Title.astro';

/**
 * "Every part does one job well": the four parts of the binary as a bento of
 * media cards (the reference's "Every piece of art tells a story" grid), each
 * with a small visual made of the real requests, a line of copy and a link to
 * its guide. Facts follow docs/schema-auth.md, docs/storage.md,
 * docs/webhooks.md and docs/panel.md.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const bento = dict.landing.bento;
const [signIn, files, webhooks, panel] = bento.cards;

const CARDS: ReadonlyArray<{ point: typeof signIn; icon: IconName; doc: DocKey; link: string; layout: string }> = [
  { point: signIn, icon: 'key', doc: 'auth', link: dict.docs.links.auth, layout: 'b-signin' },
  { point: files, icon: 'folder', doc: 'storage', link: dict.docs.links.storage, layout: 'b-files' },
  { point: webhooks, icon: 'zap', doc: 'webhooks', link: dict.docs.links.webhooks, layout: 'b-hooks' },
  { point: panel, icon: 'layout', doc: 'panel', link: dict.panel.docs, layout: 'b-panel' },
];

// Ids of the drawn table's rows; widths and avatar colors are in the CSS.
const ROWS = ['128', '127', '126', '125', '124'];
---

<section id="features" class="scroll-mt-24 py-12 md:py-20" aria-labelledby="bento-title">
  <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
    <div class="text-center">
      <Eyebrow parts={bento.eyebrow} />
      <Title id="bento-title" parts={bento.title} class="mt-5" />
    </div>

    <ul class="bento mt-14" data-stagger>
      {
        CARDS.map((card) => (
          <li class:list={['bento-card', card.layout]}>
            <div class="bento-visual" aria-hidden="true">
              {card.layout === 'b-signin' && (
                <>
                  <span class="token t1">POST /auth/v1/token</span>
                  <span class="token t2">← 200 · access_token</span>
                  <span class="token t3">refresh_token rotated</span>
                  <span class="bubble bg-pop-pink absolute top-4 right-5">@HanielCota</span>
                </>
              )}
              {card.layout === 'b-files' && <Icon name="folder" size={88} class="opacity-90" />}
              {card.layout === 'b-hooks' && (
                <pre class="hooklog">{'POST /hooks   ← 503\nretry in 30 s\nPOST /hooks   ← 200 ✓'}</pre>
              )}
              {card.layout === 'b-panel' && (
                <span class="panel-win">
                  <span class="panel-bar">
                    <span class="panel-dots" />
                    <span class="panel-url">/admin/tables/notes</span>
                  </span>
                  <span class="panel-tabs">
                    {bento.panelTabs.map((tab, i) => (
                      <span class:list={['panel-tab', i === 0 && 'is-on']}>{tab}</span>
                    ))}
                  </span>
                  <span class="panel-head">
                    <span class="font-semibold">notes</span>
                    <span class="panel-rls">RLS · 2 policies</span>
                  </span>
                  <span class="panel-grid">
                    {ROWS.map((id) => (
                      <span class="panel-row">
                        <span class="panel-id">{id}</span>
                        <span class="panel-bar-cell" />
                        <span class="panel-avatar" />
                      </span>
                    ))}
                  </span>
                </span>
                <span class="panel-sql">
                  <span class="block">select count(*) from notes;</span>
                  <span class="mt-1 block font-semibold">→ 128</span>
                </span>
              )}
            </div>
            <div class="bento-copy">
              <p class="flex items-center gap-2 text-lg font-semibold tracking-[-0.02em]">
                <Icon name={card.icon} size={18} />
                {card.point.title}
              </p>
              <p class="mt-1.5 text-[0.9375rem] leading-relaxed">{card.point.body}</p>
              <a href={docHref(card.doc, locale)} class="bento-link mt-4">
                {card.link}
                <Icon name="arrow" size={14} />
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .bento {
    display: grid;
    gap: 1rem;
  }
  @media (width >= 64rem) {
    .bento {
      grid-template-columns: 1.15fr 1fr;
      grid-auto-rows: minmax(22rem, auto);
    }
    .b-panel {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    /* The third card spans the row, so the grid closes without a hole. */
    .bento-card.b-hooks {
      grid-column: 1 / -1;
      min-height: 0;
      flex-direction: row;
      align-items: center;
    }
    .b-hooks .bento-visual {
      order: 2;
      min-height: 13rem;
    }
    .b-hooks .bento-copy {
      flex: 1;
      padding: 1.75rem;
    }
  }
  .bento-card {
    display: flex;
    min-height: 22rem;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #0b0d0c10;
    border-radius: 1.75rem;
    box-shadow: 0 24px 48px -30px #0b0d0c59;
  }
  .bento-visual {
    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    min-height: 11rem;
    padding: 1.5rem;
  }
  .bento-copy {
    padding: 0 1.75rem 1.75rem;
  }
  .bento-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    background-color: #ffffff;
    color: #111213;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .b-signin { background-color: #ffffff; color: #111213; }
  .b-signin .bento-link { background-color: #111213; color: #ffffff; }
  .b-files { background-color: #2f54ff; color: #ffffff; }
  .b-hooks { background-color: #e3f76a; color: #1d2306; }
  .b-hooks .bento-link { background-color: #1d2306; color: #e3f76a; }
  .b-panel { background-color: var(--color-night); color: #eef3f0; }

  .token {
    position: absolute;
    padding: 0.55rem 0.8rem;
    border-radius: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    box-shadow: 0 12px 24px -16px #0b0d0c80;
  }
  .t1 { top: 22%; left: 10%; background-color: var(--color-night); color: #87dba6; transform: rotate(-4deg); }
  .t2 { top: 45%; left: 24%; background-color: #cdbdff; color: #1c1440; transform: rotate(2deg); }
  .t3 { top: 66%; left: 12%; background-color: #f1dfb8; color: #2a2112; transform: rotate(-1deg); }

  .hooklog {
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background-color: #1d2306;
    color: #e3f76a;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    transform: rotate(-3deg);
  }
  /* A small drawing of the real panel: page pills, a table with its RLS badge, a query. */
  .panel-win {
    display: block;
    width: min(100%, 22rem);
    overflow: hidden;
    border: 1px solid #ffffff1a;
    border-radius: 1.25rem;
    background-color: #131416;
    box-shadow: 0 32px 64px -32px #000000b3;
    font-size: 0.75rem;
  }
  .panel-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid #ffffff12;
  }
  .panel-dots {
    width: 0.45rem;
    height: 0.45rem;
    flex-shrink: 0;
    border-radius: 999px;
    background-color: #ffffff2e;
    box-shadow: 0.7rem 0 0 #ffffff2e, 1.4rem 0 0 #ffffff2e;
    margin-right: 1.4rem;
  }
  .panel-url {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #eef3f099;
  }
  .panel-tabs {
    display: flex;
    gap: 0.35rem;
    padding: 0.8rem 0.9rem 0;
  }
  .panel-tab {
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background-color: #ffffff0d;
    color: #eef3f0b3;
    font-size: 0.6875rem;
  }
  .panel-tab.is-on {
    background-color: #87dba6;
    color: #07130c;
    font-weight: 600;
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0.9rem 0.6rem;
    font-size: 0.875rem;
  }
  .panel-rls {
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background-color: #87dba61f;
    color: #8ee6ae;
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }
  .panel-grid {
    display: block;
    padding: 0 0.9rem 0.9rem;
  }
  .panel-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0;
    border-top: 1px solid #ffffff0f;
  }
  .panel-id {
    width: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #eef3f080;
  }
  .panel-bar-cell {
    height: 0.4rem;
    border-radius: 999px;
    background-color: #ffffff29;
  }
  .panel-row:nth-child(1) .panel-bar-cell { width: 72%; }
  .panel-row:nth-child(2) .panel-bar-cell { width: 54%; }
  .panel-row:nth-child(3) .panel-bar-cell { width: 64%; }
  .panel-row:nth-child(4) .panel-bar-cell { width: 46%; }
  .panel-row:nth-child(5) .panel-bar-cell { width: 58%; }
  .panel-row:nth-child(odd) .panel-avatar { background-color: #cdbdff; }
  .panel-row:nth-child(2) .panel-avatar { background-color: #f1dfb8; }
  .panel-row:nth-child(4) .panel-avatar { background-color: #ff6b3d; }
  .panel-row:nth-child(3) .panel-avatar { background-color: #87dba6; }
  .panel-avatar {
    background-color: #cdbdff;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    margin-left: auto;
    border-radius: 999px;
  }
  .panel-sql {
    position: absolute;
    right: 8%;
    bottom: 12%;
    padding: 0.75rem 1rem;
    border-radius: 0.9rem;
    background-color: #1b7640;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    box-shadow: 0 20px 40px -20px #000000b3;
    transform: rotate(-3deg);
  }
</style>
