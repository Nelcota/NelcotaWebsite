---
import { type Locale, t } from '../../i18n/utils.ts';
import { docHref } from '../../lib/docs/links.ts';
import type { DocKey } from '../../lib/site.ts';
import Icon, { type IconName } from '../Icon.astro';
import Eyebrow from './Eyebrow.astro';
import Title from './Title.astro';

/**
 * "Every part does one job well": the four parts of the binary as a bento of
 * media cards (the reference's "Every piece of art tells a story" grid), each
 * with a small visual made of the real requests, a line of copy and a link to
 * its guide. Facts follow docs/schema-auth.md, docs/storage.md,
 * docs/webhooks.md and docs/panel.md.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const bento = dict.landing.bento;
const [signIn, files, webhooks, panel] = bento.cards;

const CARDS: ReadonlyArray<{ point: typeof signIn; icon: IconName; doc: DocKey; link: string; layout: string }> = [
  { point: signIn, icon: 'key', doc: 'auth', link: dict.docs.links.auth, layout: 'b-signin' },
  { point: files, icon: 'folder', doc: 'storage', link: dict.docs.links.storage, layout: 'b-files' },
  { point: webhooks, icon: 'zap', doc: 'webhooks', link: dict.docs.links.webhooks, layout: 'b-hooks' },
  { point: panel, icon: 'layout', doc: 'panel', link: dict.panel.docs, layout: 'b-panel' },
];
---

<section id="features" class="scroll-mt-24 py-12 md:py-20" aria-labelledby="bento-title">
  <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
    <div class="text-center">
      <Eyebrow parts={bento.eyebrow} />
      <Title id="bento-title" parts={bento.title} class="mt-5" />
    </div>

    <ul class="bento mt-14" data-stagger>
      {
        CARDS.map((card) => (
          <li class:list={['bento-card', card.layout]}>
            <div class="bento-visual" aria-hidden="true">
              {card.layout === 'b-signin' && (
                <>
                  <span class="token t1">POST /auth/v1/token</span>
                  <span class="token t2">← 200 · access_token</span>
                  <span class="token t3">refresh_token rotated</span>
                  <span class="bubble bg-pop-pink absolute top-4 right-5">@HanielCota</span>
                </>
              )}
              {card.layout === 'b-files' && <Icon name="folder" size={88} class="opacity-90" />}
              {card.layout === 'b-hooks' && (
                <pre class="hooklog">{'POST /hooks   ← 503\nretry in 30 s\nPOST /hooks   ← 200 ✓'}</pre>
              )}
              {card.layout === 'b-panel' && (
                <span class="phone">
                  <span class="block text-[0.6875rem]">/admin/</span>
                  <span class="mt-1 block text-lg font-semibold">notes</span>
                  <span class="mt-2 block h-1.5 w-3/4 rounded-full bg-white/30" />
                  <span class="mt-1.5 block h-1.5 w-1/2 rounded-full bg-white/20" />
                  <span class="mt-1.5 block h-1.5 w-2/3 rounded-full bg-white/20" />
                </span>
              )}
            </div>
            <div class="bento-copy">
              <p class="flex items-center gap-2 text-lg font-semibold tracking-[-0.02em]">
                <Icon name={card.icon} size={18} />
                {card.point.title}
              </p>
              <p class="mt-1.5 text-[0.9375rem] leading-relaxed">{card.point.body}</p>
              <a href={docHref(card.doc, locale)} class="bento-link mt-4">
                {card.link}
                <Icon name="arrow" size={14} />
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .bento {
    display: grid;
    gap: 1rem;
  }
  @media (width >= 64rem) {
    .bento {
      grid-template-columns: 1.15fr 1fr;
      grid-auto-rows: minmax(22rem, auto);
    }
    .b-panel {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    /* The third card spans the row, so the grid closes without a hole. */
    .bento-card.b-hooks {
      grid-column: 1 / -1;
      min-height: 0;
      flex-direction: row;
      align-items: center;
    }
    .b-hooks .bento-visual {
      order: 2;
      min-height: 13rem;
    }
    .b-hooks .bento-copy {
      flex: 1;
      padding: 1.75rem;
    }
  }
  .bento-card {
    display: flex;
    min-height: 22rem;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #0b0d0c10;
    border-radius: 1.75rem;
    box-shadow: 0 24px 48px -30px #0b0d0c59;
  }
  .bento-visual {
    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    min-height: 11rem;
    padding: 1.5rem;
  }
  .bento-copy {
    padding: 0 1.75rem 1.75rem;
  }
  .bento-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    background-color: #ffffff;
    color: #111213;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .b-signin { background-color: #ffffff; color: #111213; }
  .b-signin .bento-link { background-color: #111213; color: #ffffff; }
  .b-files { background-color: #2f54ff; color: #ffffff; }
  .b-hooks { background-color: #e3f76a; color: #1d2306; }
  .b-hooks .bento-link { background-color: #1d2306; color: #e3f76a; }
  .b-panel { background-color: var(--color-night); color: #eef3f0; }

  .token {
    position: absolute;
    padding: 0.55rem 0.8rem;
    border-radius: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    box-shadow: 0 12px 24px -16px #0b0d0c80;
  }
  .t1 { top: 22%; left: 10%; background-color: var(--color-night); color: #87dba6; transform: rotate(-4deg); }
  .t2 { top: 45%; left: 24%; background-color: #cdbdff; color: #1c1440; transform: rotate(2deg); }
  .t3 { top: 66%; left: 12%; background-color: #f1dfb8; color: #2a2112; transform: rotate(-1deg); }

  .hooklog {
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background-color: #1d2306;
    color: #e3f76a;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    transform: rotate(-3deg);
  }
  .phone {
    display: block;
    width: 11rem;
    height: 15rem;
    padding: 1.25rem;
    border: 1px solid #ffffff1f;
    border-radius: 1.75rem;
    background-color: #1b7640;
    color: #ffffff;
    transform: rotate(4deg);
  }
</style>
