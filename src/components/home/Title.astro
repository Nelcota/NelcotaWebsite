---
import type { TwoTone } from '../../i18n/types.ts';
import Words from '../story/Words.astro';

/**
 * A two-tone heading, gallery style: the first part in ink, the second softer
 * (gray) or in the brand color. Words rise in on scroll (motion/index.ts).
 */
type Size = 'section' | 'card';
type Tone = 'soft' | 'ink';

interface Props {
  parts: TwoTone;
  id?: string;
  size?: Size;
  tone?: Tone;
  /** Put the second part on its own line. */
  split?: boolean;
  class?: string;
}
const { parts, id, size = 'section', tone = 'soft', split = true, class: className } = Astro.props;
const [first, second] = parts;

const SIZE: Readonly<Record<Size, string>> = {
  section: 'text-[clamp(2.25rem,5.2vw,4.25rem)] leading-[1.02] tracking-[-0.045em]',
  card: 'text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.05] tracking-[-0.04em]',
};
const TONE: Readonly<Record<Tone, string>> = {
  soft: 'text-faint',
  ink: 'text-ink',
};
---

<h2 id={id} class:list={['font-semibold text-balance text-ink', SIZE[size], className]} data-words>
  <span class:list={[split && 'block']}><Words text={first} /></span>
  {!split && ' '}
  <span class:list={[split && 'block', TONE[tone]]}><Words text={second} /></span>
</h2>
