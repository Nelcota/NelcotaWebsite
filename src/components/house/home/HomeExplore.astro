---
import { HOME_EXPLORE, HOME_EXPLORE_CARDS, HOME_SERVICES } from '../../../data/house/home.ts';

/** "Por onde você quer começar?": one card per page of the site, plus the contact button. */
---

<section class="he" aria-labelledby="h-explorar">
  <div class="h-wrap he-inner">
    <div class="he-head">
      <h2 id="h-explorar">{HOME_EXPLORE.title}</h2>
      <div class="he-aside">
        <span>{HOME_EXPLORE.sub}</span>
        <a class="h-btn h-btn-primary" href="#contato">{HOME_SERVICES.cta}</a>
      </div>
    </div>
    <div class="he-grid">
      {
        HOME_EXPLORE_CARDS.map((card) => (
          <a class="he-card" href={card.href}>
            <span class="he-card-title">
              {card.title}
              <span class="he-arrow">
                <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h9M8 3.5L11.5 7 8 10.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </span>
            </span>
            <span class="he-card-text">{card.text}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .he {
    border-top: 1px solid var(--h-line);
  }
  :global(.house) .he-inner {
    padding-top: 120px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .he-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .he-head h2 {
    margin: 0;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .he-aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    font-size: 15px;
    color: var(--h-muted);
  }
  .he-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 12px;
  }
  .he-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 150px;
    padding: 24px;
    border-radius: 18px;
    border: 1px solid #ffffff1a;
    text-decoration: none;
    transition: border-color 0.25s ease;
  }
  .he-card:hover {
    border-color: #1a73ff99;
  }
  .he-card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 20px;
    font-weight: 600;
  }
  .he-arrow {
    display: flex;
    color: var(--h-blue-ink);
    transition: transform 0.25s var(--h-ease);
  }
  .he-card:hover .he-arrow {
    transform: translateX(4px);
  }
  .he-card-text {
    font-size: 15px;
    line-height: 1.5;
    color: var(--h-muted);
  }
  @media (max-width: 760px) {
    :global(.house) .he-inner {
      padding-top: 72px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .he-card,
    .he-arrow {
      transition: none;
    }
  }
</style>
