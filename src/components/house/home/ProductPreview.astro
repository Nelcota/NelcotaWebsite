---
import { Image } from 'astro:assets';
import lojaProntaPrime from '../../../assets/house/loja-pronta-prime.png';
import nelcotaBaas from '../../../assets/house/nelcota-baas.jpg';
import sellbridge from '../../../assets/house/sellbridge.jpg';
import type { HomePreview } from '../../../data/house/home.ts';

/** Top of a product card: a screenshot, the two clients, or a list of status pills. */
interface Props {
  preview: HomePreview;
}
const { preview } = Astro.props;
---

{
  preview.type === 'baas' && (
    <figure class="pv-fig">
      <Image class="pv-shot pv-top" src={nelcotaBaas} alt="Página inicial do Nelcota BaaS em nelcota.com" widths={[520, 800]} sizes="(max-width: 760px) 90vw, 520px" />
      <figcaption>nelcota.com</figcaption>
    </figure>
  )
}
{
  preview.type === 'clients' && (
    <div class="pv-pair">
      <figure class="pv-fig">
        <Image class="pv-shot pv-top-left" src={sellbridge} alt="Página inicial da SellBridge" widths={[260, 520]} sizes="(max-width: 760px) 45vw, 260px" />
        <figcaption>SellBridge</figcaption>
      </figure>
      <figure class="pv-fig">
        <div class="pv-mascot">
          <Image src={lojaProntaPrime} alt="Mascote da Loja Pronta Prime" width={240} height={240} />
        </div>
        <figcaption>Loja Pronta Prime</figcaption>
      </figure>
    </div>
  )
}
{
  preview.type === 'rows' && (
    <ul class="pv-rows">
      {preview.rows.map((row) => (
        <li>
          <span class="pv-row-title">{row.title}</span>
          <span class="h-status" data-kind={row.kind}>{row.pill}</span>
        </li>
      ))}
    </ul>
  )
}

<style>
  .pv-fig {
    margin: 0;
    height: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pv-fig figcaption {
    font-size: 12px;
    color: var(--h-muted);
  }
  .pv-fig :global(.pv-shot) {
    width: 100%;
    height: auto;
    flex: 1;
    min-height: 0;
    object-fit: cover;
    border-radius: 12px;
    display: block;
  }
  .pv-fig :global(.pv-top) {
    object-position: top center;
  }
  .pv-fig :global(.pv-top-left) {
    object-position: top left;
  }
  .pv-pair {
    height: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .pv-mascot {
    flex: 1;
    min-height: 0;
    padding: 8px;
    border-radius: 12px;
    background: var(--h-bg-2);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .pv-mascot :global(img) {
    width: auto;
    height: 100%;
    max-height: 120px;
    max-width: 100%;
    object-fit: contain;
    display: block;
  }
  .pv-rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pv-rows li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 0;
  }
  .pv-row-title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 14px;
    font-weight: 600;
  }
  .pv-rows .h-status {
    flex-shrink: 0;
  }
</style>
