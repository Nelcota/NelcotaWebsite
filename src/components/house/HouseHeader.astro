---
import mark from '../../assets/house/mark.webp';
import { HOUSE_NAV, HOUSE_ROUTES, type HouseRoute } from '../../lib/house/routes.ts';

/**
 * Sticky top bar of every software house page: logo, main navigation, a call to action
 * and the phone menu. The home passes its own links (with the section each one underlines,
 * scripts/house/home-spy.ts) and makes the logo replay its opening.
 */
export interface HouseHeaderLink {
  readonly label: string;
  readonly href: string;
  /** Id of the home section this link underlines while it is being read. */
  readonly spy?: string | undefined;
  readonly isCurrent?: boolean | undefined;
}

interface Props {
  current?: HouseRoute | undefined;
  links?: readonly HouseHeaderLink[] | undefined;
  cta?: { readonly label: string; readonly href: string } | undefined;
  /** The logo replays the home opening (scripts/house/home-intro.ts) instead of only linking home. */
  replay?: boolean;
}
const { current, replay = false } = Astro.props;
const defaultLinks: readonly HouseHeaderLink[] = HOUSE_NAV.map((link) => ({
  label: link.label,
  href: HOUSE_ROUTES[link.route],
  isCurrent: link.route === current,
}));
const links = Astro.props.links ?? defaultLinks;
const cta = Astro.props.cta ?? { label: 'Fale com a gente', href: HOUSE_ROUTES.contact };
// Five links and the button need about 900 px; with more than four the menu takes over sooner.
const crowded = links.length > 4;
---

<header class:list={['hh', { 'hh-crowded': crowded }]}>
  <div class="h-wrap hh-bar">
    <a
      class="hh-brand"
      href={HOUSE_ROUTES.home}
      data-home-replay={replay ? '' : undefined}
      title={replay ? 'Rever a abertura' : undefined}
    >
      <img src={mark.src} alt="" width="36" height="36" />Nelcota
    </a>
    <nav class="hh-nav" aria-label="Principal">
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.isCurrent ? 'page' : undefined} data-home-spy={link.spy}>
            {link.label}
            {link.spy != null && <span class="hh-spy" aria-hidden="true" />}
          </a>
        ))
      }
    </nav>
    <a class="h-btn h-btn-primary hh-cta" href={cta.href}>{cta.label}</a>
    <details class="hh-menu">
      <summary aria-label="Abrir menu">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 6h12M3 12h12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </summary>
      <nav aria-label="Menu">
        {links.map((link) => <a href={link.href} aria-current={link.isCurrent ? 'page' : undefined}>{link.label}</a>)}
        <a class="h-btn h-btn-primary" href={cta.href}>{cta.label}</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .hh {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #141416e6;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--h-line);
  }
  .hh-bar {
    height: var(--h-nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .hh-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .hh-brand img {
    width: 36px;
    height: 36px;
    margin-left: -5px;
    display: block;
  }
  .hh-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .hh-nav a,
  .hh-menu nav a:not(.h-btn) {
    position: relative;
    display: flex;
    align-items: center;
    height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  .hh-nav a:hover {
    background: var(--h-hover);
  }
  .hh-nav a[aria-current='page'],
  .hh-menu nav a[aria-current='page'] {
    font-weight: 600;
    background: #ffffff12;
  }
  .hh-spy {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 4px;
    height: 2px;
    border-radius: 2px;
    background: var(--h-blue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--h-ease);
  }
  [data-active] .hh-spy {
    transform: scaleX(1);
  }
  .hh-menu {
    display: none;
    position: relative;
  }
  .hh-menu summary {
    list-style: none;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--h-bg-3);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .hh-menu summary::-webkit-details-marker {
    display: none;
  }
  .hh-menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 220px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px;
    border: 1px solid var(--h-line-strong);
    border-radius: 16px;
    background: var(--h-bg-2);
  }
  .hh-menu nav .h-btn {
    margin-top: 4px;
  }
  /* :global(.house) so these beat `.house .h-btn { display: inline-flex }` in house.css. */
  @media (max-width: 760px) {
    .hh-nav,
    :global(.house) .hh-cta {
      display: none;
    }
    .hh-menu {
      display: block;
    }
  }
  @media (max-width: 920px) {
    .hh-crowded .hh-nav,
    :global(.house) .hh-crowded .hh-cta {
      display: none;
    }
    .hh-crowded .hh-menu {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hh-spy {
      transition: none;
    }
  }
</style>

<script>
  // Closes the phone menu after a link is chosen (same-page anchors keep it open otherwise).
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.hh-menu nav a')) {
    link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
  }
</script>
