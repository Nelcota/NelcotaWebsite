---
/** "Ver no GitHub" card button with the repository name under it. */
interface Props {
  name: string;
  href: string;
}
const { name, href } = Astro.props;
const repo = href.replace('https://github.com/', '');
---

<a class="gl" href={href} aria-label={`Ver ${name} no GitHub`}>
  <svg width="28" height="28" viewBox="0 0 16 16" aria-hidden="true">
    <path
      fill="currentColor"
      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
    ></path>
  </svg>
  <span class="gl-text">
    <span class="gl-title">Ver no GitHub</span>
    <span class="gl-repo">{repo}</span>
  </span>
  <span class="gl-arrow" aria-hidden="true">↗</span>
</a>

<style>
  .gl {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    padding: 12px 18px 12px 14px;
    border-radius: 14px;
    border: 1px solid var(--h-line);
    background: var(--h-bg-2);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }
  .gl:hover {
    background: #222226;
    transform: translateY(-1px);
  }
  .gl svg {
    flex-shrink: 0;
  }
  .gl-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .gl-title {
    font-size: 15px;
    font-weight: 600;
  }
  .gl-repo {
    font-size: 13px;
    color: var(--h-dim);
    overflow-wrap: anywhere;
  }
  .gl-arrow {
    margin-left: 6px;
    font-size: 15px;
    color: var(--h-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .gl {
      transition: none;
    }
    .gl:hover {
      transform: none;
    }
  }
</style>
