---
import type { RateLimitStatusItem } from '../../../data/house/rate-limit.ts';

/** "O que já existe e o que falta": a ready column and a missing column. */
interface Props {
  ready: readonly RateLimitStatusItem[];
  missing: readonly RateLimitStatusItem[];
}
const { ready, missing } = Astro.props;
const columns = [
  { title: 'Pronto', kind: 'ready', items: ready },
  { title: 'Falta', kind: 'missing', items: missing },
] as const;
---

<section class="rs" aria-labelledby="estado">
  <h2 id="estado">O que já existe e o que falta</h2>
  {columns.map((column) => (
    <div class="rs-card">
      <h3 class="rs-title" data-kind={column.kind}>{column.title}</h3>
      <ul>
        {column.items.map((item) => <li class:list={{ pending: item.pending }}>{item.text}</li>)}
      </ul>
    </div>
  ))}
</section>

<style>
  .rs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 16px;
  }
  .rs h2 {
    grid-column: 1 / -1;
    margin: 0;
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .rs-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border-radius: 20px;
    border: 1px solid var(--h-line-strong);
  }
  .rs-title {
    margin: 0;
    font-family: var(--h-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .rs-title[data-kind='ready'] {
    color: var(--h-green);
  }
  .rs-title[data-kind='missing'] {
    color: var(--h-amber);
  }
  .rs-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 16px;
  }
  .rs-card li.pending {
    color: var(--h-dim);
  }
</style>
