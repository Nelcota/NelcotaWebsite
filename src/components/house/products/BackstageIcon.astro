---
import type { BackstageIcon } from '../../../data/house/products.ts';

/** 20px line icon for an internal tool (Lucide-style strokes from the mockup). */
interface Props {
  icon: BackstageIcon;
}
const { icon } = Astro.props;
---

<svg class="bi" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
  {icon === 'pr' && (
    <>
      <circle cx="18" cy="18" r="3"></circle>
      <circle cx="6" cy="6" r="3"></circle>
      <path d="M13 6h3a2 2 0 0 1 2 2v7"></path>
      <path d="M6 9v12"></path>
    </>
  )}
  {icon === 'template' && (
    <>
      <rect width="18" height="7" x="3" y="3" rx="1"></rect>
      <rect width="9" height="7" x="3" y="14" rx="1"></rect>
      <rect width="5" height="7" x="16" y="14" rx="1"></rect>
    </>
  )}
  {icon === 'checks' && (
    <>
      <path d="m3 17 2 2 4-4"></path>
      <path d="m3 7 2 2 4-4"></path>
      <path d="M13 6h8"></path>
      <path d="M13 12h8"></path>
      <path d="M13 18h8"></path>
    </>
  )}
  {icon === 'book' && (
    <>
      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
    </>
  )}
</svg>

<style>
  .bi {
    display: block;
    fill: none;
    stroke: var(--h-muted);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
