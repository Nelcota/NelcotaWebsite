---
import type { Locale } from '../i18n/utils.ts';
import Base from '../layouts/Base.astro';
import HomeXray from './home/HomeXray.astro';

/**
 * Releitura test page: home sections being redesigned, shown alone before any
 * of them joins the home (docs/ROADMAP.md). Kept out of search and the sitemap.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Base locale={locale} noindex path="releitura/">
  <HomeXray locale={locale} />
</Base>
