---
import { Picture } from 'astro:assets';
import mascot from '../assets/mascot.png';
import { type Locale, t } from '../i18n/utils.ts';
import { ORG_URL, QUICKSTART_URL } from '../lib/site.ts';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
---

<section class="relative overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[32rem] bg-[radial-gradient(60rem_24rem_at_70%_-10%,var(--color-mint-soft),transparent_70%)]"
  >
  </div>

  <div class="container-page grid items-center gap-10 py-16 md:grid-cols-[1.2fr_0.8fr] md:py-24 lg:gap-16">
    <div class="animate-rise">
      <ul class="mb-6 flex flex-wrap gap-2" aria-label="Highlights">
        {
          dict.hero.badges.map((badge) => (
            <li class="pill border border-line bg-surface text-muted">
              <span class="size-1.5 rounded-full bg-mint-deep" aria-hidden="true" />
              {badge}
            </li>
          ))
        }
      </ul>

      <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl">
        {dict.hero.tagline}
        <span class="block text-mint-ink">{dict.hero.taglineSecond}</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg text-pretty text-muted">{dict.hero.subtitle}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={QUICKSTART_URL}
          rel="noopener"
          class="inline-flex h-12 items-center gap-2 rounded-full bg-mint px-6 font-semibold text-on-mint shadow-float transition-transform hover:-translate-y-0.5"
        >
          {dict.hero.quickstart}
          <Icon name="arrow" size={18} />
        </a>
        <a
          href={ORG_URL}
          rel="me noopener"
          class="inline-flex h-12 items-center gap-2 rounded-full border border-line bg-surface px-6 font-semibold text-ink transition-colors hover:bg-raised"
        >
          <Icon name="github" size={18} />
          {dict.hero.github}
        </a>
      </div>
    </div>

    <div class="flex justify-center md:justify-end">
      <div
        class="animate-float relative rounded-[2.25rem] bg-[#edfef2] p-4 shadow-card ring-1 ring-mint/40 motion-safe:[animation-delay:0.6s]"
      >
        <Picture
          src={mascot}
          formats={['avif', 'webp']}
          widths={[176, 224, 352, 448]}
          sizes="(min-width: 768px) 224px, 176px"
          width={224}
          height={224}
          alt={dict.a11y.mascotAlt}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
          class="size-44 rounded-[1.5rem] md:size-56"
        />
      </div>
    </div>
  </div>
</section>
