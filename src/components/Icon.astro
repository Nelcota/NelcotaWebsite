---
import { ICONS, type IconName, iconSymbolId } from '../lib/icons.ts';
import { SPRITE_URL } from '../lib/sprite.ts';

export type { IconName };

/**
 * A line icon. The drawing lives in the shared sprite file (src/lib/sprite.ts);
 * this only references it and sets how it is painted (stroke or fill).
 */
interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className, size = 20 } = Astro.props;
const icon = ICONS[name];
---

<svg
  aria-hidden="true"
  focusable="false"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={icon.fill ? 'currentColor' : 'none'}
  stroke={icon.fill ? 'none' : 'currentColor'}
  stroke-width={icon.fill ? undefined : 1.8}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <use href={`${SPRITE_URL}#${iconSymbolId(name)}`} />
</svg>
