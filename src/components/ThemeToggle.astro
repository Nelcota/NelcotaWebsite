---
import Icon from './Icon.astro';

interface Props {
  label: string;
  class?: string;
}
const { label, class: className } = Astro.props;
---

<button type="button" data-theme-toggle aria-label={label} aria-pressed="false" data-tooltip={label} class={className}>
  <Icon name="moon" size={18} class="theme-icon-moon" />
  <Icon name="sun" size={18} class="theme-icon-sun" />
</button>

<script>
  import '../scripts/theme-toggle.ts';
</script>
