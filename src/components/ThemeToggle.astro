---
import Icon from './Icon.astro';

interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label={label}
  title={label}
  class="inline-flex size-10 items-center justify-center rounded-full text-muted transition-colors hover:bg-raised hover:text-ink"
>
  <Icon name="moon" class="theme-icon-moon" />
  <Icon name="sun" class="theme-icon-sun" />
</button>

<script>
  const root = document.documentElement;
  const KEY = 'nelcota-theme';

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const current =
        root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem(KEY, next);
      } catch {
        /* storage may be unavailable (private mode, blocked); the toggle still works for this page */
      }
    });
  }
</script>
