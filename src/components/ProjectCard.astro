---
import { formatDate, formatNumber, formatRelative, type Locale, t } from '../i18n/utils.ts';
import type { ProjectView } from '../lib/projects.ts';
import { spdxUrl } from '../lib/site.ts';
import Icon from './Icon.astro';

interface Props {
  project: ProjectView;
  locale: Locale;
  variant?: 'featured' | 'default' | 'compact';
  now?: Date;
}
const { project, locale, variant = 'default', now = new Date() } = Astro.props;
const dict = t(locale);
const { data, github } = project;
const description = data.description[locale];
const language = github?.language ?? data.language;
const license = github?.license ?? data.license;
const release = github?.latestRelease ?? null;
const pushedAt = github?.pushedAt ?? null;
const headingId = `project-${project.id}`;

---

<article
  aria-labelledby={headingId}
  class:list={[
    'card relative flex flex-col gap-4 transition-shadow hover:shadow-float',
    variant === 'featured' ? 'p-7 md:p-9' : variant === 'compact' ? 'p-5' : 'p-6',
    variant === 'featured' && 'bg-[linear-gradient(160deg,var(--color-mint-soft),var(--color-surface)_55%)]',
  ]}
>
  <header class="flex flex-wrap items-center gap-2">
    <h3 id={headingId} class:list={['font-semibold tracking-tight', variant === 'featured' ? 'text-3xl' : 'text-xl']}>
      <a href={data.url} rel="noopener" class="after:absolute after:inset-0 after:rounded-[var(--radius-card)]">
        {data.name}
      </a>
    </h3>
    {variant === 'featured' && <span class="pill bg-mint text-on-mint">{dict.projects.featured}</span>}
    {
      data.status === 'in-progress' && (
        <span class="pill border border-mint-deep/40 bg-mint-soft text-mint-ink">{dict.projects.inProgress}</span>
      )
    }
  </header>

  <p class:list={['text-pretty text-muted', variant === 'featured' ? 'max-w-2xl text-lg' : 'text-sm']}>
    {description}
  </p>

  <ul class="flex flex-wrap gap-1.5" aria-label="Stack">
    {data.stack.map((item) => <li class="pill bg-raised text-ink">{item}</li>)}
  </ul>

  <dl class="mt-auto flex flex-wrap gap-x-4 gap-y-1.5 text-sm">
    <div class="flex items-center gap-1.5">
      <dt class="sr-only">Language</dt>
      <dd class="flex items-center gap-1.5 text-muted">
        <span class="lang-dot size-2.5 rounded-full ring-1 ring-black/10" data-lang={language} aria-hidden="true"></span>
        {language}
      </dd>
    </div>
    <div class="flex items-center gap-1.5">
      <dt class="sr-only">{dict.projects.license}</dt>
      <dd class="relative z-10 text-muted">
        <a href={spdxUrl(license)} rel="noopener license" class="hover:text-mint-ink">{license}</a>
      </dd>
    </div>
    {
      github ? (
        <>
          <div class="flex items-center gap-1.5">
            <dt class="sr-only">{dict.projects.stars}</dt>
            <dd class="flex items-center gap-1.5 text-muted">
              <Icon name="star" size={16} />
              {formatNumber(github.stars, locale)} {dict.projects.stars}
            </dd>
          </div>
          <div class="flex items-center gap-1.5">
            <dt class="sr-only">{dict.projects.latestRelease}</dt>
            <dd class="relative z-10 flex items-center gap-1.5 text-muted">
              <Icon name="tag" size={16} />
              {release ? (
                <a href={release.url} rel="noopener" class="font-mono text-[0.8125rem] hover:text-mint-ink">
                  {release.tag}
                </a>
              ) : (
                <span>{dict.projects.noRelease}</span>
              )}
            </dd>
          </div>
          {pushedAt && (
            <div class="flex items-center gap-1.5">
              <dt class="sr-only">{dict.projects.updated}</dt>
              <dd class="flex items-center gap-1.5 text-muted">
                <Icon name="clock" size={16} />
                <time datetime={pushedAt} title={formatDate(pushedAt, locale)}>
                  {dict.projects.updated} {formatRelative(pushedAt, locale, now)}
                </time>
              </dd>
            </div>
          )}
        </>
      ) : (
        <div class="flex items-center gap-1.5">
          <dt class="sr-only">GitHub</dt>
          <dd class="flex items-center gap-1.5 text-muted">
            <Icon name="github" size={16} />
            {dict.projects.notPublic}
          </dd>
        </div>
      )
    }
  </dl>

  {
    data.links.length > 0 && (
      <ul class="relative z-10 flex flex-wrap gap-x-4 gap-y-1 border-t border-line/70 pt-4 text-sm font-medium">
        {data.links.map((link) => (
          <li>
            <a href={link.href} rel="noopener" class="inline-flex items-center gap-1 text-mint-ink hover:underline">
              {link.label[locale]}
              <Icon name="external" size={14} />
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  [data-lang='Rust'] {
    background-color: #dea584;
  }
  [data-lang='TypeScript'] {
    background-color: #3178c6;
  }
  [data-lang='Go'] {
    background-color: #00add8;
  }
  [data-lang]:not([data-lang='Rust']):not([data-lang='TypeScript']):not([data-lang='Go']) {
    background-color: var(--color-mint-deep);
  }
</style>
