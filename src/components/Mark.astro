---
import BrandLogo, { type BrandName } from './BrandLogo.astro';
import Icon, { type IconName } from './Icon.astro';

/**
 * A small leading mark: an official brand logo when the item is a real product
 * (PostgreSQL, Caddy, Google…), otherwise a line icon in the accent color.
 */
export type MarkSpec =
  | { readonly kind: 'icon'; readonly name: IconName }
  | { readonly kind: 'brand'; readonly name: BrandName };

export const icon = (name: IconName): MarkSpec => ({ kind: 'icon', name });
export const brand = (name: BrandName): MarkSpec => ({ kind: 'brand', name });

interface Props {
  mark: MarkSpec;
  size?: number;
}
const { mark, size = 18 } = Astro.props;
---

{
  mark.kind === 'brand' ? (
    <BrandLogo name={mark.name} size={size} class="shrink-0" />
  ) : (
    <Icon name={mark.name} size={size} class="shrink-0 text-mint-ink" />
  )
}
