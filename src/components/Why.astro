---
import { type Locale, t } from '../i18n/utils.ts';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const icons = ['database', 'server', 'code'] as const;
---

<section id="why" class="scroll-mt-24 py-16 md:py-24" aria-labelledby="why-title">
  <div class="container-page">
    <div class="max-w-2xl">
      <h2 id="why-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">{dict.why.title}</h2>
      <p class="mt-3 text-lg text-pretty text-muted">{dict.why.intro}</p>
    </div>
    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {
        dict.why.points.map((point, index) => (
          <li class="card p-6">
            <span class="inline-flex size-11 items-center justify-center rounded-2xl bg-mint-soft text-mint-ink">
              <Icon name={icons[index] ?? 'code'} size={22} />
            </span>
            <h3 class="mt-4 text-lg font-semibold">{point.title}</h3>
            <p class="mt-2 text-sm text-pretty text-muted">{point.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
