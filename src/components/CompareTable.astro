---
import { type Group, PRODUCT_INFO, PRODUCTS, type Product, RIVALS, type Support } from '../data/compare.ts';
import { type Locale, t } from '../i18n/utils.ts';
import { PRODUCT_TONE } from './compare-strings.ts';
import Icon from './Icon.astro';

/**
 * The comparison table as a spec sheet on a white card: Nelcota and the three
 * rivals side by side, with a yes / partly / no mark and a short note per cell.
 * On wide screens the product row sticks under the header while the table
 * scrolls. On phones and tablets it shows Nelcota beside one rival, picked
 * with a segmented control made of radio buttons (CSS only, see the styles
 * below). One per page: the radio ids are fixed.
 */
interface Props {
  locale: Locale;
  groups: readonly Group[];
}
const { locale, groups } = Astro.props;
const copy = t(locale).compare;

const SUPPORT_LABEL: Readonly<Record<Support, string>> = {
  yes: copy.legend.yes,
  partial: copy.legend.partial,
  no: copy.legend.no,
};

const isNelcota = (product: Product): boolean => product === 'nelcota';
---

<div class="compare">
  <div class="picker mb-4 lg:hidden">
    <fieldset>
      <legend class="mb-2 w-full pt-2 text-center text-sm text-muted">{copy.pickLabel}</legend>
      <div class="segmented mx-auto grid max-w-md grid-cols-3 gap-1 rounded-full p-1">
        {
          RIVALS.map((rival, index) => (
            <label class="pick relative flex min-h-11 items-center justify-center rounded-full px-2 text-sm font-semibold text-muted">
              <input type="radio" name="compare-with" value={rival} id={`vs-${rival}`} class="sr-only" checked={index === 0} />
              {PRODUCT_INFO[rival].name}
            </label>
          ))
        }
      </div>
    </fieldset>
  </div>

  <div class="sheet card">
    <table class="w-full table-fixed border-collapse text-left text-sm sm:text-[0.9375rem]">
      <caption class="sr-only">{copy.tableLabel}</caption>
      <thead>
        <tr>
          <th scope="col" class="feature-head p-5 align-bottom text-xs font-bold tracking-[0.14em] text-faint uppercase lg:w-[22%]">
            {copy.feature}
          </th>
          {
            PRODUCTS.map((product) => (
              <th scope="col" data-col={product} class:list={['product-head p-4 align-bottom sm:p-5', isNelcota(product) && 'is-nelcota']}>
                <span class="flex items-center gap-2">
                  <span class:list={['size-2.5 shrink-0 rounded-full', PRODUCT_TONE[product]]} aria-hidden="true" />
                  <span class="text-base font-semibold tracking-[-0.02em] text-ink sm:text-lg">{PRODUCT_INFO[product].name}</span>
                </span>
                <span class="mt-1 block font-mono text-xs font-normal text-faint">{PRODUCT_INFO[product].version[locale]}</span>
              </th>
            ))
          }
        </tr>
      </thead>
      {
        groups.map((group) => (
          <tbody>
            <tr class="group-row">
              {/* One cell per column, so hiding a rival on phones also hides its share of this row. */}
              <th scope="rowgroup" class="px-4 py-3.5 text-[0.6875rem] sm:px-5 font-bold tracking-[0.16em] text-ink uppercase">
                {group.title[locale]}
              </th>
              {PRODUCTS.map((product) => (
                <td data-col={product} class:list={['group-cell', isNelcota(product) && 'is-nelcota']} />
              ))}
            </tr>
            {group.rows.map((row) => (
              <tr class="data-row align-top">
                <th scope="row" class="row-label p-4 font-semibold text-ink sm:p-5">{row.label[locale]}</th>
                {PRODUCTS.map((product) => {
                  const cell = row.cells[product];

                  return (
                    <td data-col={product} class:list={['p-4 sm:p-5', isNelcota(product) ? 'is-nelcota text-ink' : 'text-muted']}>
                      <span class="flex items-start gap-2.5">
                        {cell.support != null && (
                          <span class:list={['mark shrink-0', `mark-${cell.support}`]}>
                            {cell.support === 'yes' && <Icon name="check" size={13} />}
                            {cell.support === 'no' && <Icon name="x" size={13} />}
                            <span class="sr-only">{SUPPORT_LABEL[cell.support]}:</span>
                          </span>
                        )}
                        <span class="min-w-0 leading-relaxed text-pretty">{cell.text[locale]}</span>
                      </span>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        ))
      }
    </table>
  </div>

  <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-muted" aria-label={copy.legend.title}>
    <li class="flex items-center gap-2"><span class="mark mark-yes"><Icon name="check" size={13} /></span>{copy.legend.yes}</li>
    <li class="flex items-center gap-2"><span class="mark mark-partial"></span>{copy.legend.partial}</li>
    <li class="flex items-center gap-2"><span class="mark mark-no"><Icon name="x" size={13} /></span>{copy.legend.no}</li>
  </ul>
</div>

<style>
  /* clip, not hidden: rounds the corners without breaking the sticky header row. */
  .sheet {
    overflow: clip;
  }

  .data-row,
  .group-row {
    border-top: 1px solid var(--color-line);
  }
  /* A quiet band names each group; it interrupts Nelcota's column on purpose, like a section break. */
  .group-row > * {
    background-color: light-dark(#fafaf9, #1e1f22);
  }
  .is-nelcota {
    background-color: var(--color-mint-wash);
  }
  .product-head.is-nelcota {
    box-shadow: inset 0 3px 0 var(--color-pop-forest);
  }
  /* Each rival wears its own color as softly as Nelcota wears mint: a faint wash and a muted top bar. */
  .product-head[data-col='supabase'] {
    --tone: var(--color-pop-lime);
  }
  .product-head[data-col='pocketbase'] {
    --tone: var(--color-pop-lilac);
  }
  /* Pink is the most saturated of the four: a lighter mix keeps it level with the others. */
  .product-head[data-col='appwrite'] {
    --tone: var(--color-pop-pink);
    --tone-light-wash: 6%;
  }
  .product-head:not(.is-nelcota) {
    --tone-wash: light-dark(
      color-mix(in oklab, var(--tone) var(--tone-light-wash, 12%), transparent),
      color-mix(in oklab, var(--tone) 6%, transparent)
    );
    --tone-bar: light-dark(
      color-mix(in oklab, var(--tone) 75%, transparent),
      color-mix(in oklab, var(--tone) 45%, transparent)
    );
    background-image: linear-gradient(var(--tone-wash), var(--tone-wash));
    box-shadow: inset 0 3px 0 var(--tone-bar);
  }

  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.125rem;
    border-radius: 999px;
  }
  .mark-yes {
    color: var(--color-mint-ink);
    background-color: light-dark(#0f7a3d1a, #8ee6ae1f);
  }
  .mark-no {
    color: var(--color-muted);
    background-color: var(--color-raised);
  }
  /* Half-filled dot: there, with limits spelled out in the cell. */
  .mark-partial {
    width: 0.875rem;
    height: 0.875rem;
    margin: 0.3125rem 0.1875rem 0;
    border: 1.5px solid var(--color-mint-ink);
    background: linear-gradient(90deg, var(--color-mint-ink) 50%, transparent 50%);
  }

  /* Phones: the rival picker rides under the site header, so switching never means scrolling back up. */
  .picker {
    position: sticky;
    top: calc(4rem + env(safe-area-inset-top));
    z-index: 2;
    padding-block: 0.25rem 0.625rem;
    background-color: var(--color-canvas);
  }

  .segmented {
    background-color: var(--color-raised);
  }
  .pick {
    transition:
      background-color 150ms,
      color 150ms;
  }
  .pick:has(:checked) {
    background-color: var(--color-surface);
    color: var(--color-ink);
    box-shadow:
      0 1px 3px #0000001f,
      0 1px 1px #0000000f;
  }
  .pick:has(:focus-visible) {
    outline: 2px solid var(--color-mint-deep);
    outline-offset: 2px;
  }

  /* Wide screens: the product row stays under the fixed site header while the long table scrolls. */
  @media (width >= 64rem) {
    .compare thead th {
      position: sticky;
      top: calc(4rem + env(safe-area-inset-top));
      z-index: 1;
      background-color: var(--color-surface);
      box-shadow: inset 0 -1px 0 var(--color-line);
    }
    /* The mint wash is translucent: lay it over the white so rows do not show through. */
    .compare thead th.is-nelcota {
      background-image: linear-gradient(var(--color-mint-wash), var(--color-mint-wash));
      box-shadow:
        inset 0 3px 0 var(--color-pop-forest),
        inset 0 -1px 0 var(--color-line);
    }
    .compare thead th.product-head:not(.is-nelcota) {
      box-shadow:
        inset 0 3px 0 var(--tone-bar),
        inset 0 -1px 0 var(--color-line);
    }
    .data-row:hover > * {
      background-color: light-dark(#0000000a, #ffffff08);
    }
    .data-row:hover > .is-nelcota {
      background-color: light-dark(#87dba633, #87dba61f);
    }
  }

  /*
   * Phones and tablets: Nelcota beside the picked rival only. Each row becomes
   * a two-column grid with the feature name on its own line above, so the
   * cells keep a readable width instead of breaking words.
   */
  @media (width < 64rem) {
    .compare table,
    .compare thead,
    .compare tbody {
      display: block;
    }
    .compare tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .compare thead tr {
      border-bottom: 1px solid var(--color-line);
    }
    .compare .feature-head,
    .compare .group-cell {
      display: none;
    }
    .compare .row-label,
    .compare th[scope='rowgroup'] {
      grid-column: 1 / -1;
    }
    .compare .row-label {
      padding-bottom: 0.25rem;
    }

    .compare:has(#vs-supabase:checked) [data-col='pocketbase'],
    .compare:has(#vs-supabase:checked) [data-col='appwrite'],
    .compare:has(#vs-pocketbase:checked) [data-col='supabase'],
    .compare:has(#vs-pocketbase:checked) [data-col='appwrite'],
    .compare:has(#vs-appwrite:checked) [data-col='supabase'],
    .compare:has(#vs-appwrite:checked) [data-col='pocketbase'] {
      display: none;
    }
  }
</style>
