---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A product screenshot in both themes. Only the one matching the active theme
 * is displayed; lazy images that are display:none are never downloaded.
 */
interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { light, dark, alt, sizes, eager = false, class: className } = Astro.props;
const widths = [480, 640, 800, 1200, 1440].filter((width) => width <= light.width);
const loading = eager ? 'eager' : 'lazy';
---

<div class:list={['overflow-hidden rounded-lg border border-line bg-surface', className]}>
  <Picture src={light} alt={alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} loading={loading} decoding="async" class="only-light h-auto w-full" />
  <Picture src={dark} alt={alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} loading={loading} decoding="async" class="only-dark h-auto w-full" />
</div>
