---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A product screenshot in both themes. Only the one matching the active theme
 * is displayed; lazy images that are display:none are never downloaded.
 */
interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  sizes: string;
  class?: string;
}
const { light, dark, alt, sizes, class: className } = Astro.props;
/** srcset steps; none wider than the source, so nothing is upscaled. */
const CANDIDATE_WIDTHS: readonly number[] = [480, 640, 800, 1200, 1440];
const widths = CANDIDATE_WIDTHS.filter((width) => width <= light.width);
---

<div class:list={['overflow-hidden rounded-lg border border-line bg-surface', className]}>
  <Picture src={light} alt={alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} loading="lazy" decoding="async" class="only-light h-auto w-full" />
  <Picture src={dark} alt={alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} loading="lazy" decoding="async" class="only-dark h-auto w-full" />
</div>
