---
import { type Locale, t } from '../i18n/utils.ts';
import CopyScript from './CopyScript.astro';
import Icon from './Icon.astro';

interface Props {
  /** id of the element whose textContent is copied */
  target: string;
  locale: Locale;
  /** id of the caption naming what is copied, so the button is not just "Copy". */
  describedBy?: string | undefined;
}

const { target, locale, describedBy } = Astro.props;
const dict = t(locale);
---

<button
  type="button"
  data-copy={target}
  data-copied={dict.code.copied}
  data-failed={dict.code.copyFailed}
  aria-describedby={describedBy}
  class="inline-flex shrink-0 items-center gap-1.5 transition-colors hit-area h-7 rounded-[var(--radius-control)] px-2 font-mono text-xs absolute top-2 right-3 text-faint hover:bg-raised hover:text-ink"
>
  <Icon name="copy" size={13} class="copy-icon-idle" />
  <Icon name="check" size={13} class="copy-icon-done hidden" />
  <span data-copy-label>{dict.code.copy}</span>
</button>

<CopyScript />

<style>
  [data-state='done'] .copy-icon-idle {
    display: none;
  }
  [data-state='done'] .copy-icon-done {
    display: block;
  }
  [data-state='done'] {
    color: var(--color-mint-ink);
  }
</style>
