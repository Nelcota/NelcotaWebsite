---
/**
 * The official mascot from the admin panel (crates/admin/ui/src/assets/mascot.png),
 * at logo size, for the header brand.
 * Drawn as a CSS background from a 64 px WebP that Vite inlines once into the
 * stylesheet (under its 4 KB limit): no request competing with the fonts, and no
 * repeated data URI in the HTML. Decorative: it always sits next to the name.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
const SIZE_CLASS: Readonly<Record<number, string>> = { 20: 'size-5', 28: 'size-7', 32: 'size-8' };
const sizeClass = SIZE_CLASS[size] ?? 'size-7';
---

<span class:list={['mascot-mark inline-block shrink-0', sizeClass, className]} aria-hidden="true"></span>

<style>
  .mascot-mark {
    background-image: url('../assets/mascot/mark-64.webp');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
  }
</style>
