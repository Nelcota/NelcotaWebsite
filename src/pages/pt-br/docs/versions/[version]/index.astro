---
import type { GetStaticPaths } from 'astro';
import DocsIndex from '../../../../../components/docs/DocsIndex.astro';
import { loadDocs } from '../../../../../lib/docs/content.ts';
import { docsVersion, RELEASE_DOC_VERSIONS } from '../../../../../lib/docs/versions.ts';

export const getStaticPaths = (() => RELEASE_DOC_VERSIONS.map(({ id }) => ({ params: { version: id } }))) satisfies GetStaticPaths;
const version = docsVersion(Astro.params.version).id;
const bundle = await loadDocs('pt-br', version);
---

<DocsIndex locale="pt-br" bundle={bundle} />
