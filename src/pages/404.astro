---
import { Picture } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import mascot from '../assets/mascot/standing.png';
import { t } from '../i18n/utils.ts';
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../lib/site.ts';

/**
 * Not found, gallery style: a giant "4 0 4" whose zero is the mascot on a pop
 * colored disc, then the message. The server cannot know the visitor's
 * language here, so the page speaks English with the Portuguese line under it
 * and links home in both locales. Never indexed.
 */
const en = t('en');
const pt = t('pt-br');
---

<Base locale="en" title={`${en.notFound.title} · ${SITE_NAME}`} description={en.notFound.body} noindex>
  <section class="container-page flex flex-col items-center pt-12 pb-24 text-center md:pt-20 md:pb-32" aria-labelledby="not-found-title">
    <div class="code flex items-center justify-center">
      <span class="digit" aria-hidden="true">4</span>
      <span class="disc relative mx-1 flex shrink-0 items-end justify-center sm:mx-3">
        <span class="handle handle-left absolute bg-pop-blue text-white" aria-hidden="true">@nelcota</span>
        <span class="handle handle-right absolute bg-pop-ink text-white" aria-hidden="true">@404</span>
        <Picture
          src={mascot}
          formats={['avif', 'webp']}
          widths={[160, 320]}
          sizes="(width >= 40rem) 160px, 96px"
          width={160}
          height={182}
          alt={en.a11y.mascotAlt}
          loading="eager"
          fetchpriority="high"
          class="mascot h-auto"
        />
      </span>
      <span class="digit" aria-hidden="true">4</span>
    </div>

    <p class="eyebrow mt-12 md:mt-16">{en.notFound.eyebrow} · <span lang="pt-BR">{pt.notFound.eyebrow}</span> <span class="eyebrow-accent">404</span></p>
    <h1 id="not-found-title" class="mt-4 text-[clamp(2.5rem,6vw,4.5rem)] leading-[1] font-semibold tracking-[-0.045em] text-ink">
      {en.notFound.title}
    </h1>
    <p class="mt-6 max-w-md text-lg leading-relaxed text-muted">{en.notFound.body}</p>
    <p lang="pt-BR" class="mt-1 max-w-md text-lg leading-relaxed text-faint">{pt.notFound.body}</p>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href={getRelativeLocaleUrl('en')} class="btn btn-primary">{en.notFound.home}</a>
      <a href={getRelativeLocaleUrl('pt-br')} hreflang="pt-BR" lang="pt-BR" class="btn btn-secondary">
        {pt.notFound.home}
      </a>
    </div>
  </section>
</Base>

<style>
  .digit {
    font-size: clamp(7rem, 30vw, 17rem);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  /* The zero: a lime disc the size of a digit, the mascot standing in it and leaning a little. */
  .disc {
    width: clamp(5.5rem, 24vw, 13.5rem);
    aspect-ratio: 1;
    border-radius: 999px;
    background-color: var(--color-pop-lime);
    box-shadow:
      0 1px 2px #0000001a,
      0 30px 50px -28px #00000080;
  }
  .disc :global(.mascot) {
    width: 52%;
    margin-bottom: 8%;
    transform: rotate(-8deg);
  }

  .handle {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.75rem;
    border-radius: 999px 999px 999px 0.3rem;
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 10px 24px -12px #0b0d0c80;
  }
  .handle-left {
    top: -0.5rem;
    left: -1.75rem;
  }
  .handle-right {
    right: -1.5rem;
    bottom: 0.75rem;
    border-radius: 999px 0.3rem 999px 999px;
  }

  /* Phones: one bubble only, smaller, so neither covers a digit. */
  @media (width < 40rem) {
    .handle {
      padding: 0.2rem 0.5rem;
      font-size: 0.6875rem;
    }
    .handle-left {
      top: -0.75rem;
      left: -1rem;
    }
    .handle-right {
      display: none;
    }
  }

  @media (width >= 40rem) {
    .disc :global(.mascot) {
      width: 62%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .disc :global(.mascot) {
      animation: peek 3.2s var(--ease-soft) infinite alternate;
    }
  }

  @keyframes peek {
    to {
      transform: rotate(6deg) translateY(-4%);
    }
  }
</style>
