---
/**
 * LAB · Releitura da home (teste isolado).
 * Página independente: não usa Base.astro nem global.css, então não afeta o resto do site.
 * Para remover o teste, apague este arquivo.
 */
import { Font, Picture } from 'astro:assets';
import mark from '../assets/mascot/mark-64.webp';
import overviewDark from '../assets/screens/nelcota-overview-dark.png';
import { INSTALL_COMMAND, withBase } from '../lib/site.ts';

const docs = withBase('docs/');
const home = withBase('');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Nelcota · Releitura (lab)</title>
    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <link rel="icon" href={withBase('favicon.png')} type="image/png" />
    <meta name="theme-color" content="#0a0b0c" />
  </head>
  <body class="rl">
    <nav id="nav"><div class="wrap">
      <a class="brand" href="#top"><span class="mark"><img src={mark.src} alt="" width="20" height="20" /></span>Nelcota</a>
      <ul>
        <li><a href="#xray">Como funciona</a></li>
        <li><a href="#seguranca">Segurança</a></li>
        <li><a href="#painel">Painel</a></li>
        <li><a href="#comecar">Começar</a></li>
        <li><a href={docs}>Docs</a></li>
      </ul>
      <a class="cmp" href={home} target="_blank" rel="noopener">ver versão atual ↗</a>
    </div></nav>

    <main id="top">
      <section class="boot wrap" id="boot" aria-label="Início">
        <div class="term" id="term" aria-live="polite">
          <div class="line"><span class="p">$</span> <span class="cmd" id="typed"></span><span class="caret" id="caret"></span></div>
        </div>
        <div class="press" id="press">
          <button class="key" id="key" type="button" aria-label="Iniciar o servidor">enter ↵</button>
          <small>Aperte qualquer tecla para subir o servidor.<br />Um binário, seu VPS.</small>
        </div>
        <button class="skip" id="skip" type="button">pular introdução →</button>

        <div class="hero">
          <h1><span>Um backend inteiro.</span><span>Um binário.</span><span class="g">Seu VPS.</span></h1>
          <div class="hero-row">
            <p>API REST gerada do seu schema, login, arquivos, webhooks e painel admin, rodando no <b>seu PostgreSQL</b>. Sem conta, sem cobrança por requisição, sem uma dúzia de serviços para cuidar.</p>
            <div class="cta">
              <div class="copy"><code><i>$</i> {INSTALL_COMMAND}</code><button class="btn sm" data-copy={INSTALL_COMMAND} type="button">copiar</button></div>
              <div class="btns"><a class="btn pri" href="#comecar">Instalar agora →</a><a class="btn" href={docs}>Ler a documentação</a></div>
            </div>
          </div>
        </div>
      </section>

      <section class="num num-a" aria-label="128 MiB de memória">
        <div class="cap">memória do app<br />no teste de carga<br /><b>1 CPU · 128 MiB</b></div>
        <div class="big" aria-hidden="true">128<span class="o">MiB</span></div>
        <div class="bar"></div>
      </section>

      <section class="xray" id="xray" aria-label="Raio-X de uma requisição">
        <div class="stick"><div class="wrap">
          <div class="xr-top">
            <div><span class="label">Raio-X · <b>uma requisição</b></span><h2>Tudo o que acontece<br />dentro de um binário.</h2></div>
            <span class="req"><i>GET</i> /rest/v1/notes?order=id.desc</span>
          </div>
          <div class="track" id="track"></div>
          <div class="wire" id="wire"><div class="fill"></div><div class="pkt"></div></div>
          <div class="detail" id="detail"></div>
          <div class="xr-foot" id="xrfoot">role para atravessar as camadas</div>
        </div></div>
      </section>

      <section class="num num-b" aria-label="1.965 requisições por segundo">
        <div class="cap">leituras indexadas<br />4,4 ms de mediana a 600 req/s<br /><b>release candidate · main</b></div>
        <div class="big" aria-hidden="true">1.965<span class="o">req/s</span></div>
        <div class="bar"></div>
      </section>

      <section class="sec" id="seguranca"><div class="wrap">
        <div class="head rv">
          <div><span class="label">Seguro <b>por padrão</b></span><h2>Trancado antes da sua <em>primeira linha.</em></h2></div>
          <p>Sem checklist de endurecimento para lembrar depois. Tudo isto já está ligado no primeiro <span class="mono">nelcota dev</span>.</p>
        </div>
        <div class="rows rv">
          <div class="row"><span class="i">01</span><div><h4>Argon2id + rate limit</h4><p>Senhas com hash, logins limitados e a mesma resposta para e-mail desconhecido e senha errada.</p></div></div>
          <div class="row"><span class="i">02</span><div><h4>Tokens de 15 minutos</h4><p>Tokens de acesso Ed25519. Refresh tokens giram, e um reutilizado revoga a sessão.</p></div></div>
          <div class="row"><span class="i">03</span><div><h4>RLS em toda requisição</h4><p>Papel e claims vivem na transação. Token inválido nunca vira anon.</p></div></div>
          <div class="row"><span class="i">04</span><div><h4>Webhooks ficam do lado de fora</h4><p>Só HTTPS. Endereços privados e de metadados de nuvem são bloqueados.</p></div></div>
          <div class="row"><span class="i">05</span><div><h4>Arquivos em sandbox</h4><p>Arquivos servidos pela Nelcota levam nosniff e CSP sandbox.</p></div></div>
          <div class="row"><span class="i">06</span><div><h4>Sem unsafe Rust</h4><p>unsafe é proibido, cargo-deny confere dependências, 500+ testes automatizados.</p></div></div>
        </div>
        <p class="note rv">Ainda 0.x: as <a href={withBase('docs/security/')}>notas de segurança</a> listam o que falta.</p>
      </div></section>

      <section class="sec tight" id="painel"><div class="wrap">
        <div class="head rv">
          <div><span class="label">Painel <b>incluído</b></span><h2>Nada mais<br />para instalar.</h2></div>
          <p>Tabelas, usuários, arquivos, políticas e SQL em <span class="mono">/admin/</span>, sem outro serviço rodando.</p>
        </div>
        <div class="panel rv">
          <Picture src={overviewDark} alt="Visão geral do painel admin da Nelcota, com gráfico de tráfego da API e contagem de tabelas e usuários" formats={['avif', 'webp']} widths={[800, 1200, 1440]} sizes="(min-width: 80rem) 76rem, 100vw" loading="lazy" decoding="async" />
        </div>
        <div class="p-cap rv"><span>/admin/ · visão geral</span><a class="mono" href={withBase('docs/panel/')}>guia do painel →</a></div>
      </div></section>

      <section class="num num-c" aria-label="Licença de zero dólares">
        <div class="cap">Apache-2.0<br />você paga o servidor,<br /><b>não cada requisição</b></div>
        <div class="big" aria-hidden="true">$0<span class="o">/sempre</span></div>
        <div class="bar"></div>
      </section>

      <section class="sec" id="comecar"><div class="wrap">
        <div class="head rv">
          <div><span class="label">Começar</span><h2>Do zero à API<br />em <em>três passos.</em></h2></div>
          <p>Você precisa de Linux com Docker. No macOS e no Windows, compile a partir do código-fonte.</p>
        </div>
        <div class="steps rv">
          <div class="step"><div class="h"><span>01</span><h4>Instalar e subir</h4></div><p>Um comando instala a CLI. <span class="mono">nelcota dev</span> sobe o PostgreSQL e a API na porta 8000.</p>
<pre><span class="c"># instalar a CLI</span>
curl -fsSL …/install.sh | sh
mkdir notes-app && cd notes-app
<span class="k">nelcota dev</span></pre></div>
          <div class="step"><div class="h"><span>02</span><h4>Escrever o schema</h4></div><p>Uma migration com a tabela e as regras de acesso. Aplique e gere os tipos.</p>
<pre><span class="k">CREATE TABLE</span> notes (
  id    bigint <span class="k">PRIMARY KEY</span>,
  owner uuid <span class="k">DEFAULT</span> auth.uid(),
  body  text
);
<span class="k">ENABLE ROW LEVEL SECURITY</span>;</pre></div>
          <div class="step"><div class="h"><span>03</span><h4>Usar a API</h4></div><p>Crie um usuário e leia as notas com o token dele. O RLS devolve só as dele.</p>
<pre><span class="k">await</span> nelcota
  .from(<span class="s">'notes'</span>)
  .select(<span class="s">'id,body'</span>)
<span class="c">// ← 200 · só as linhas do dono</span></pre></div>
        </div>
      </div></section>
    </main>

    <footer><div class="wrap"><span>Nelcota · releitura de teste</span><span>Seu código, seus dados, seu servidor.</span></div></footer>
    <div class="lab">LAB · releitura</div>
  </body>
</html>

<style is:global>
  .rl{
    --bg:#0A0B0C; --bg2:#111315; --ink:#ECECE8; --muted:#7C8085; --dim:#4A4E52; --line:#212427;
    --green:#87DBA6; --green-ink:#07130C; --green-dim:#1D5C39;
    --sans:var(--font-manrope),ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
    --mono:var(--font-jetbrains-mono),ui-monospace,"Cascadia Code",Consolas,Menlo,monospace;
    --gut:max(16px,4vw); --max:1240px;
    margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:17px;line-height:1.55;-webkit-font-smoothing:antialiased;overflow-x:hidden;color-scheme:dark
  }
  .rl *{box-sizing:border-box}
  html:has(.rl){scroll-behavior:smooth;background:#0A0B0C}
  .rl a{color:inherit}
  .rl ::selection{background:var(--green);color:var(--green-ink)}
  .rl :focus-visible{outline:2px solid var(--green);outline-offset:3px}
  .rl .mono{font-family:var(--mono)}
  .rl .wrap{max-width:var(--max);margin:0 auto;padding-inline:var(--gut)}
  .rl .label{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .rl .label b{color:var(--green);font-weight:400}

  .rl nav{position:fixed;inset:0 0 auto;z-index:20;border-bottom:1px solid transparent;transition:background .3s,border-color .3s}
  .rl nav.solid{background:rgba(10,11,12,.86);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-color:var(--line)}
  .rl nav .wrap{display:flex;align-items:center;gap:24px;height:60px}
  .rl .brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-weight:700;letter-spacing:-.01em}
  .rl .mark{width:30px;height:30px;border-radius:9px;background:#1d5c39;display:grid;place-items:center;box-shadow:inset 0 1px 0 #ffffff26}
  .rl .mark img{display:block;width:20px;height:20px}
  .rl nav ul{display:flex;gap:22px;list-style:none;margin:0 0 0 auto;padding:0;font-size:14px;color:var(--muted)}
  .rl nav ul a{text-decoration:none}
  .rl nav ul a:hover{color:var(--ink)}
  .rl .cmp{font-family:var(--mono);font-size:12px;border:1px solid var(--line);border-radius:999px;padding:5px 12px;text-decoration:none;color:var(--muted);white-space:nowrap}
  .rl .cmp:hover{color:var(--ink);border-color:var(--dim)}

  .rl .boot{min-height:100svh;display:flex;flex-direction:column;justify-content:center;padding-top:60px;position:relative}
  .rl .term{font-family:var(--mono);font-size:clamp(13px,1.25vw,15px);line-height:1.9;color:var(--muted);min-height:13.5em}
  .rl .term .cmd{color:var(--ink)}
  .rl .term .ok,.rl .term .p{color:var(--green)}
  .rl .caret{display:inline-block;width:.6em;height:1.15em;background:var(--green);vertical-align:-.2em;margin-left:2px;animation:rl-blink 1s steps(1) infinite}
  @keyframes rl-blink{50%{opacity:0}}
  .rl .line{white-space:pre;overflow:hidden;text-overflow:ellipsis}
  .rl .press{display:flex;align-items:center;gap:20px;margin-top:28px;flex-wrap:wrap;transition:opacity .3s}
  .rl .press.busy{opacity:.35}
  .rl .key{appearance:none;border:1.5px solid var(--green);background:transparent;color:var(--green);font-family:var(--mono);font-size:clamp(28px,4vw,44px);padding:.35em .9em .4em;border-radius:14px;cursor:pointer;box-shadow:0 6px 0 var(--green-dim);transition:transform .08s,box-shadow .08s,background .2s}
  .rl .key:hover{background:rgba(135,219,166,.07)}
  .rl .key.down{transform:translateY(5px);box-shadow:0 1px 0 var(--green-dim)}
  .rl .press small{font-family:var(--mono);font-size:13px;color:var(--muted);line-height:1.6}
  .rl .skip{position:absolute;right:var(--gut);bottom:28px;font-family:var(--mono);font-size:12px;color:var(--dim);background:none;border:0;cursor:pointer;padding:6px}
  .rl .skip:hover{color:var(--muted)}

  .rl .hero{display:none}
  .rl .booted .hero{display:block}
  .rl .booted .press,.rl .booted .skip{display:none}
  .rl .booted .term{min-height:0;margin-bottom:clamp(24px,4vh,48px)}
  .rl .hero h1{font-size:clamp(44px,7vw,108px);line-height:.92;letter-spacing:-.045em;font-weight:700;margin:0 0 28px}
  .rl .hero h1 span{display:block;opacity:0;transform:translateY(24px);transition:opacity .6s cubic-bezier(.2,.7,.2,1),transform .6s cubic-bezier(.2,.7,.2,1)}
  .rl .hero h1 .g{color:var(--green)}
  .rl .in .hero h1 span{opacity:1;transform:none}
  .rl .in .hero h1 span:nth-child(2){transition-delay:.12s}
  .rl .in .hero h1 span:nth-child(3){transition-delay:.24s}
  .rl .hero-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,5vw,80px);align-items:end;opacity:0;transition:opacity .6s .4s}
  .rl .in .hero-row{opacity:1}
  .rl .hero p{margin:0;color:var(--muted);font-size:clamp(17px,1.4vw,20px);max-width:44ch}
  .rl .hero p b{color:var(--ink);font-weight:600}
  .rl .cta{display:flex;flex-direction:column;gap:14px;min-width:0}
  .rl .copy{display:flex;align-items:center;gap:12px;border:1px solid var(--line);background:var(--bg2);border-radius:10px;padding:12px 12px 12px 16px;font-family:var(--mono);font-size:13px;min-width:0}
  .rl .copy code{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--ink);font-family:var(--mono)}
  .rl .copy code i{color:var(--green);font-style:normal}
  .rl .btn{appearance:none;border:1px solid var(--line);background:transparent;color:var(--ink);font:600 14px var(--sans);padding:10px 16px;border-radius:999px;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:8px;white-space:nowrap}
  .rl .btn:hover{border-color:var(--dim)}
  .rl .btn.pri{background:var(--green);border-color:var(--green);color:var(--green-ink)}
  .rl .btn.pri:hover{filter:brightness(1.08)}
  .rl .btn.sm{padding:6px 12px;font:400 12px var(--mono)}
  .rl .btns{display:flex;gap:10px;flex-wrap:wrap}

  .rl .num{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:clamp(24px,4vw,48px) 0;overflow:hidden;position:relative}
  .rl .num .big{font-weight:700;letter-spacing:-.055em;line-height:1.02;white-space:nowrap;padding-left:var(--gut);padding-bottom:.02em}
  .rl .num-a .big{font-size:clamp(80px,23vw,360px)}
  .rl .num-b .big{font-size:clamp(70px,17vw,280px)}
  .rl .num-c .big{font-size:clamp(66px,16vw,260px)}
  .rl .num .o{color:var(--bg);-webkit-text-stroke:4px var(--ink);paint-order:stroke fill;margin-left:.08em}
  .rl .num .cap{position:absolute;right:var(--gut);top:clamp(18px,3vw,36px);text-align:right;font-family:var(--mono);font-size:12px;line-height:1.7;color:var(--muted);max-width:30ch}
  .rl .num .cap b{color:var(--green);font-weight:400}
  .rl .num .bar{height:4px;background:var(--green);margin:clamp(16px,2.6vw,32px) var(--gut) 0;transform-origin:left;transform:scaleX(0);transition:transform 1.2s cubic-bezier(.2,.7,.2,1)}
  .rl .num.vis .bar{transform:scaleX(1)}

  .rl .sec{padding:clamp(80px,12vw,160px) 0}
  .rl .sec.tight{padding-top:0}
  .rl .head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,5vw,80px);align-items:end;margin-bottom:clamp(40px,6vw,72px)}
  .rl .head h2{font-size:clamp(34px,5vw,64px);line-height:1;letter-spacing:-.035em;font-weight:700;margin:12px 0 0;text-wrap:balance}
  .rl .head h2 em{font-style:normal;color:var(--green)}
  .rl .head p{margin:0;color:var(--muted);max-width:48ch}

  .rl .xray{height:560vh;position:relative}
  .rl .xray .stick{position:sticky;top:0;height:100svh;display:flex;flex-direction:column;justify-content:center;padding-top:60px}
  .rl .xr-top{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:22px;flex-wrap:wrap}
  .rl .xr-top h2{font-size:clamp(28px,3.6vw,48px);line-height:1.02;letter-spacing:-.03em;margin:8px 0 0;font-weight:700}
  .rl .req{font-family:var(--mono);font-size:13px;color:var(--ink);border:1px solid var(--line);border-radius:999px;padding:6px 14px;white-space:nowrap}
  .rl .req i{color:var(--green);font-style:normal}
  .rl .track{position:relative;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
  .rl .layer{border:1px dashed var(--dim);border-radius:12px;padding:14px;min-height:clamp(120px,17vh,170px);display:flex;flex-direction:column;justify-content:space-between;transition:border-color .3s,background-color .3s,color .3s;color:var(--muted);position:relative;overflow:hidden;
    background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:16px 16px;background-position:-1px -1px}
  .rl .layer .n{font-family:var(--mono);font-size:11px}
  .rl .layer .t{font-weight:700;font-size:clamp(15px,1.4vw,19px);letter-spacing:-.01em;color:var(--muted)}
  .rl .layer .s{font-family:var(--mono);font-size:11px;color:var(--dim)}
  .rl .layer.done{border-style:solid;border-color:var(--dim);background:var(--bg2);background-image:none}
  .rl .layer.done .t{color:var(--ink)}
  .rl .layer.on{border-style:solid;border-color:var(--green);background:#0E1A12;background-image:none;color:var(--green)}
  .rl .layer.on .t{color:var(--green)}
  .rl .layer.on .s{color:#B9EBCB}
  .rl .wire{height:2px;background:var(--line);margin:18px 0 0;position:relative}
  .rl .wire .fill{position:absolute;inset:0 auto 0 0;width:calc(var(--p,0)*100%);background:var(--green)}
  .rl .wire .pkt{position:absolute;top:50%;left:calc(var(--p,0)*100%);width:12px;height:12px;border-radius:3px;background:var(--green);transform:translate(-50%,-50%) rotate(45deg);box-shadow:0 0 0 6px rgba(135,219,166,.15)}
  .rl .detail{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(20px,4vw,56px);margin-top:28px;align-items:start;min-height:200px}
  .rl .detail h3{font-size:clamp(22px,2.4vw,30px);letter-spacing:-.02em;margin:6px 0 10px;line-height:1.1}
  .rl .detail p{margin:0;color:var(--muted);max-width:46ch}
  .rl pre{margin:0;background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:16px 18px;font-family:var(--mono);font-size:13px;line-height:1.75;overflow:auto;color:#C9CCCF;white-space:pre}
  .rl pre .k{color:var(--green)} .rl pre .c{color:var(--dim)} .rl pre .s{color:#E6E2C8}
  .rl .fade{animation:rl-fade .35s ease}
  @keyframes rl-fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  .rl .xr-foot{margin-top:18px;font-family:var(--mono);font-size:12px;color:var(--dim)}

  .rl .rows{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--line)}
  .rl .row{display:grid;grid-template-columns:44px minmax(0,1fr);gap:16px;padding:22px 24px 22px 0;border-bottom:1px solid var(--line)}
  .rl .rows .row:nth-child(2n){padding-left:24px;border-left:1px solid var(--line)}
  .rl .row .i{font-family:var(--mono);font-size:12px;color:var(--green);padding-top:4px}
  .rl .row h4{margin:0 0 4px;font-size:18px;letter-spacing:-.01em}
  .rl .row p{margin:0;color:var(--muted);font-size:15px}
  .rl .note{margin-top:20px;font-family:var(--mono);font-size:12px;color:var(--muted)}
  .rl .note a{color:var(--ink)}

  .rl .panel{border:1px solid var(--line);border-radius:18px;background:var(--bg2);padding:clamp(6px,1vw,12px);overflow:hidden}
  .rl .panel img{display:block;width:100%;height:auto;border-radius:12px}
  .rl .p-cap{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:16px;color:var(--muted);font-family:var(--mono);font-size:13px}

  .rl .steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
  .rl .step{display:flex;flex-direction:column;gap:12px;min-width:0}
  .rl .step .h{display:flex;align-items:baseline;gap:12px}
  .rl .step .h span{font-family:var(--mono);color:var(--green);font-size:13px}
  .rl .step h4{margin:0;font-size:20px;letter-spacing:-.015em}
  .rl .step p{margin:0;color:var(--muted);font-size:15px;min-height:3.2em}
  .rl .step pre{flex:1;font-size:12.5px}

  .rl footer{border-top:1px solid var(--line);padding:28px 0 40px;font-family:var(--mono);font-size:12px;color:var(--muted)}
  .rl footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
  .rl .lab{position:fixed;left:16px;bottom:16px;z-index:30;font-family:var(--mono);font-size:11px;background:var(--ink);color:var(--bg);padding:6px 10px;border-radius:6px;letter-spacing:.04em}

  .rl .rv{opacity:0;transform:translateY(18px);transition:opacity .7s cubic-bezier(.2,.7,.2,1),transform .7s cubic-bezier(.2,.7,.2,1)}
  .rl .rv.vis{opacity:1;transform:none}

  @media (max-width:900px){
    .rl nav ul{display:none}
    .rl .cmp{margin-left:auto}
    .rl .hero-row,.rl .head,.rl .detail{grid-template-columns:minmax(0,1fr)}
    .rl .track{grid-template-columns:minmax(0,1fr);gap:6px}
    .rl .layer{min-height:0;flex-direction:row;align-items:center;gap:12px;padding:10px 12px}
    .rl .layer .t{flex:1}
    .rl .wire{display:none}
    .rl .xray .stick{justify-content:flex-start;padding-top:76px}
    .rl .xr-top{margin-bottom:14px}
    .rl .detail{margin-top:16px;min-height:0;gap:12px}
    .rl .detail p{font-size:15px}
    .rl pre{font-size:12px;padding:12px 14px}
    .rl .rows{grid-template-columns:minmax(0,1fr)}
    .rl .rows .row:nth-child(2n){padding-left:0;border-left:0}
    .rl .steps{grid-template-columns:minmax(0,1fr)}
    .rl .num .cap{position:static;text-align:left;padding:0 var(--gut);margin-bottom:12px;max-width:none}
  }
  @media (max-width:520px){
    .rl .xray .stick{padding-top:68px}
    .rl .xr-top h2{font-size:26px}
    .rl .layer .s{display:none}
    .rl .detail h3{font-size:20px}
    .rl .detail pre{display:none}
    .rl .num .o{-webkit-text-stroke-width:2.5px}
  }
  @media (prefers-reduced-motion:reduce){
    html:has(.rl){scroll-behavior:auto}
    .rl *,.rl *::before,.rl *::after{animation:none!important;transition:none!important}
    .rl .rv{opacity:1;transform:none}
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector(s) as unknown as T;
  const store = {
    get(k: string) { try { return sessionStorage.getItem(k); } catch { return null; } },
    set(k: string, v: string) { try { sessionStorage.setItem(k, v); } catch { /* storage blocked */ } },
  };

  const nav = $('#nav');
  const onNav = () => nav.classList.toggle('solid', window.scrollY > 20);

  /* ---------- boot ---------- */
  const boot = $('#boot'), term = $('#term'), typed = $('#typed'), caret = $('#caret'), key = $('#key'), press = $('#press');
  const CMD = 'nelcota dev';
  const LOG: [string, string][] = [
    ['postgres (docker)', 'ok'],
    ['migrations/V1__notes.sql', 'ok'],
    ['rls · notes · 2 políticas', 'ok'],
    ['api    http://127.0.0.1:8000', 'ok'],
    ['admin  http://127.0.0.1:8000/admin/', 'ok'],
  ];
  let started = false;
  const pad = (s: string) => s + ' ' + '.'.repeat(Math.max(40 - s.length, 2)) + ' ';
  const addLine = (html: string) => { const d = document.createElement('div'); d.className = 'line'; d.innerHTML = html; term.appendChild(d); return d; };
  const okLine = (l: [string, string]) => `<span class="ok">▸</span> ${pad(l[0])}<span class="ok">${l[1]}</span>`;
  const READY = '<span class="cmd">pronto.</span> <span class="ok">backend no ar.</span>';

  function finish() {
    boot.classList.add('booted');
    caret.remove();
    requestAnimationFrame(() => requestAnimationFrame(() => boot.classList.add('in')));
    store.set('nelcota-booted', '1');
    window.removeEventListener('keydown', onKey);
  }
  function renderAll() {
    typed.textContent = CMD;
    for (const l of LOG) addLine(okLine(l));
    addLine(READY);
    finish();
  }
  function start() {
    if (started) return;
    started = true;
    key.classList.add('down');
    setTimeout(() => key.classList.remove('down'), 140);
    if (reduce) { renderAll(); return; }
    press.classList.add('busy');
    let i = typed.textContent?.length ?? 0;
    const typing = setInterval(() => {
      typed.textContent = CMD.slice(0, ++i);
      if (i >= CMD.length) { clearInterval(typing); setTimeout(logs, 220); }
    }, 45);
    function logs() {
      let j = 0;
      const next = () => {
        if (j < LOG.length) {
          const l = LOG[j++];
          if (!l) return;
          const d = addLine(`<span class="ok">▸</span> ${pad(l[0])}<span class="wait">…</span>`);
          setTimeout(() => { d.innerHTML = okLine(l); next(); }, 170 + Math.random() * 160);
        } else {
          addLine(READY);
          setTimeout(finish, 380);
        }
      };
      next();
    }
  }
  function onKey(e: KeyboardEvent) {
    if (e.metaKey || e.ctrlKey || e.altKey || e.key === 'Tab' || e.key === 'Shift') return;
    if (window.scrollY > window.innerHeight * 0.6) return;
    if (e.key === ' ' || e.key === 'Enter') e.preventDefault();
    start();
  }
  window.addEventListener('keydown', onKey);
  key.addEventListener('click', start);
  $('#skip').addEventListener('click', () => { if (!started) { started = true; renderAll(); } });
  if (store.get('nelcota-booted') === '1') { started = true; renderAll(); }
  else {
    let k = 0;
    const idle = setInterval(() => {
      if (started) { clearInterval(idle); return; }
      typed.textContent = CMD.slice(0, ++k);
      if (k >= CMD.length) clearInterval(idle);
    }, reduce ? 0 : 90);
  }

  /* ---------- copy ---------- */
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', () => {
      const txt = b.dataset.copy ?? '';
      const done = () => { b.textContent = 'copiado'; setTimeout(() => { b.textContent = 'copiar'; }, 1400); };
      navigator.clipboard ? navigator.clipboard.writeText(txt).then(done, done) : done();
    });
  });

  /* ---------- x-ray ---------- */
  const L = [
    { n: '01', t: 'Rede', s: 'rustls', h: 'A requisição chega.', p: 'HTTPS termina dentro do binário, com TLS feito em Rust. Não há proxy, gateway ou função separada no caminho.',
      c: '<span class="k">GET</span> /rest/v1/notes?order=id.desc\nhost: api.seuapp.com\nauthorization: Bearer eyJhbGciOiJFZERTQ…' },
    { n: '02', t: 'Token', s: 'Ed25519 · 15 min', h: 'Quem é você?', p: 'O token de acesso é conferido com Ed25519 e vale 15 minutos. Um token inválido é recusado, nunca vira usuário anônimo.',
      c: '<span class="c">// claims verificadas</span>\nsub   <span class="s">"6f1c…a9"</span>\nrole  <span class="s">"authenticated"</span>\nexp   <span class="k">+15 min</span>' },
    { n: '03', t: 'RLS', s: 'owner = auth.uid()', h: 'O PostgreSQL decide o que você vê.', p: 'Papel e claims entram na transação. A política da tabela filtra as linhas antes de qualquer código seu rodar.',
      c: '<span class="k">CREATE POLICY</span> notes_owner <span class="k">ON</span> notes\n  <span class="k">FOR ALL TO</span> authenticated\n  <span class="k">USING</span> (owner = auth.uid());' },
    { n: '04', t: 'Consulta', s: 'PostgreSQL', h: 'Filtros viram SQL.', p: 'A API é gerada do schema: filtros, ordem, relações e RPC se traduzem em uma consulta. Você escreveu zero endpoints.',
      c: '<span class="k">select</span> id, body\n  <span class="k">from</span> notes\n <span class="k">order by</span> id <span class="k">desc</span>;\n<span class="c">-- 2 linhas (só as suas)</span>' },
    { n: '05', t: 'Resposta', s: '200 · webhook', h: 'Volta em milissegundos.', p: 'A resposta sai em JSON. Se você assinou o evento, o webhook segue assinado, com até 6 tentativas se o seu servidor cair.',
      c: '<span class="k">200 OK</span>\n[{ "id": 2, "body": <span class="s">"Ship the webhook"</span> },\n { "id": 1, "body": <span class="s">"My first note"</span> }]\n<span class="c">→ POST /hooks · x-nelcota-signature: v1=5f2b…</span>' },
  ];
  const track = $('#track'), detail = $('#detail'), wire = $('#wire'), xray = $('#xray'), foot = $('#xrfoot');
  track.innerHTML = L.map((l, i) => `<div class="layer" data-i="${i}"><span class="n">${l.n}</span><span class="t">${l.t}</span><span class="s">${l.s}</span></div>`).join('');
  const layers = track.querySelectorAll('.layer');
  let cur = -1;
  function setLayer(i: number) {
    if (i === cur) return;
    cur = i;
    layers.forEach((el, k) => { el.classList.toggle('on', k === i); el.classList.toggle('done', k < i); });
    const l = L[i];
    if (!l) return;
    detail.innerHTML = `<div class="fade"><span class="label">Camada ${l.n} / 05 · <b>${l.t}</b></span><h3>${l.h}</h3><p>${l.p}</p></div><pre class="fade">${l.c}</pre>`;
    foot.textContent = i < L.length - 1 ? 'role para atravessar as camadas' : 'fim do caminho · um processo, uma porta';
  }
  function onX() {
    const r = xray.getBoundingClientRect();
    const total = xray.offsetHeight - window.innerHeight;
    const p = Math.min(1, Math.max(0, -r.top / total));
    wire.style.setProperty('--p', p.toFixed(4));
    setLayer(Math.min(L.length - 1, Math.floor(p * L.length * 0.999)));
  }

  /* ---------- reveal ---------- */
  const io = new IntersectionObserver((es) => {
    es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('vis'); io.unobserve(e.target); } });
  }, { threshold: 0.25 });
  for (const el of document.querySelectorAll('.rv,.num')) io.observe(el);

  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { onNav(); onX(); ticking = false; });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  onNav();
  onX();
</script>
