---
import AboutCards from '../components/house/about/AboutCards.astro';
import AboutHero from '../components/house/about/AboutHero.astro';
import AboutPrinciples from '../components/house/about/AboutPrinciples.astro';
import AboutProcess from '../components/house/about/AboutProcess.astro';
import AboutTeam from '../components/house/about/AboutTeam.astro';
import House from '../layouts/House.astro';
---

<House title="Sobre · Nelcota" description="A Nelcota cria os próprios produtos e usa a mesma base nos sistemas dos clientes." current="about">
  <div class="h-wrap ab">
    <AboutHero />
    <AboutPrinciples />
    <AboutTeam />
    <AboutProcess />
    <AboutCards />
  </div>
</House>

<style>
  .ab {
    display: flex;
    flex-direction: column;
    gap: 112px;
  }
</style>
